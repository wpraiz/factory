{
  "schema": "perfil-manifest/v1",
  "nota": "Camada de perfil do Factory. O repo e o PRODUTO (generico, vendavel); tudo que e da vida de quem usa mora no PERFIL, fora do git. Este manifesto traz so as regras genericas; o perfil local estende com as suas (perfil.local.json, mesma forma). A trava (tools/privacy-check.mjs, pre-commit) e o CI leem os dois quando existem.",
  "raiz": "",
  "raiz_env": "FACTORY_PROFILE",
  "extensao_local": "perfil.local.json",
  "classes": {
    "pessoal": { "o_que": "dados de vida do usuario: memoria, conversas, diarios, voz, acoes", "destino": "perfil", "trava": "bloqueia" },
    "segredo": { "o_que": "chaves de API, tokens, senhas", "destino": "variavel de ambiente", "trava": "bloqueia" },
    "dado": { "o_que": "logs, recibos, indices, backups", "destino": "perfil ou cache local", "trava": "bloqueia" }
  },
  "nunca_no_git": [
    { "glob": "**/*.mp3", "classe": "pessoal", "porque": "audio" },
    { "glob": "**/*.wav", "classe": "pessoal", "porque": "audio" },
    { "glob": "**/*.mp4", "classe": "pessoal", "porque": "video" },
    { "glob": "**/*transcri*", "classe": "pessoal", "porque": "transcricao de conversa" },
    { "glob": "**/*.bundle", "classe": "dado", "porque": "backup de repo" },
    { "glob": "**/*.jsonl", "classe": "dado", "porque": "logs e recibos" },
    { "glob": "**/*.env", "classe": "segredo", "porque": "variaveis com chave" },
    { "glob": "**/*token*.txt", "classe": "segredo", "porque": "token" }
  ],
  "conteudo": {
    "bloqueia": [
      { "nome": "chave sk_", "regex": "sk_[a-f0-9]{20,}" },
      { "nome": "chave sk-", "regex": "sk-[A-Za-z0-9_-]{20,}" },
      { "nome": "token GitHub", "regex": "gh[pousr]_[A-Za-z0-9]{20,}" },
      { "nome": "chave AWS", "regex": "AKIA[0-9A-Z]{16}" },
      { "nome": "chave Google", "regex": "AIza[0-9A-Za-z_-]{30,}" },
      { "nome": "chave privada", "regex": "-----BEGIN (RSA |OPENSSH )?PRIVATE KEY" },
      { "nome": "CPF", "regex": "\\b[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}\\b" }
    ],
    "aviso": []
  },
  "slots": {
    "agente-prompt": { "repo": "src/Factory/Assets/orb/agent-prompt.md", "perfil": "prompt/pessoal.md", "como": "repo + perfil anexado" },
    "vocabulario": { "repo": "src/Factory/Assets/orb/vocabulary.txt", "perfil": "vocabulario.pessoal.txt", "como": "repo + perfil" },
    "memoria": { "perfil": "memoria" },
    "chat": { "perfil": "chat" },
    "acoes": { "perfil": "acoes.json", "como": "cards da HOME" },
    "docs": { "perfil": "docs", "como": "doc com dado de vida nasce no perfil, nunca no repo" }
  }
}
