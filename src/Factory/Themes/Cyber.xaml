<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Forja Silenciosa: os controles do sistema (sidebar, caixa de texto, lista, accent) passam a usar
         a paleta Cyber em vez do azul do Windows. Valores literais de proposito: dentro de ThemeDictionaries o
         StaticResource do proprio arquivo nao e garantido. Mesmos hex da paleta abaixo. ===== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- accent do sistema (checkbox, slider, toggle, combobox) = ciano -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#00E5FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#00E5FF" Opacity="0.85" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#00E5FF" Opacity="0.70" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#00E5FF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#00E5FF" Opacity="0.85" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#00E5FF" Opacity="0.70" />

            <!-- sidebar: painel recua uma camada; o item ativo e o unico com a cor do acento -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#11161F" Opacity="0.72" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#11161F" Opacity="0.72" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#8A98AD" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#C8D3E0" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#C8D3E0" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#00E5FF" Opacity="0.08" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#00E5FF" Opacity="0.12" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#00E5FF" Opacity="0.10" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1C2433" Opacity="0.60" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1C2433" Opacity="0.45" />

            <!-- caixa de texto: painel escuro, aresta de 1 px, foco em ciano (sem a linha azul do Windows) -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#11161F" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#141A24" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A0E14" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1C2433" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2A3547" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#00E5FF" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#C8D3E0" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E6EEF7" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E6B80" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5E6B80" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E7C92" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#00E5FF" Opacity="0.35" />

            <!-- lista (sugestoes do ODIN, projetos): item marcado com ciano, nao azul -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#00E5FF" Opacity="0.08" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#00E5FF" Opacity="0.12" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#00E5FF" Opacity="0.10" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1C2433" Opacity="0.60" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1C2433" Opacity="0.45" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#00E5FF" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#00E5FF" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#00E5FF" />

            <!-- botao do sistema (hamburguer, fechar dialogo): hover discreto, na camada do painel -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C2433" Opacity="0.70" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C2433" Opacity="0.50" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Paleta fliperama cyberpunk ===== -->
    <Color x:Key="CyberBgColor">#0A0E14</Color>
    <Color x:Key="CyberPanelColor">#11161F</Color>
    <Color x:Key="CyberPanelEdgeColor">#1C2433</Color>
    <!-- roxo profundo que respira atras do fundo (o metal antes de esquentar) -->
    <Color x:Key="CyberEmberColor">#3B1E7A</Color>
    <Color x:Key="NeonCyanColor">#00E5FF</Color>
    <Color x:Key="NeonGreenColor">#39FF14</Color>
    <Color x:Key="NeonMagentaColor">#FF2A6D</Color>
    <Color x:Key="NeonAmberColor">#FFB000</Color>
    <Color x:Key="NeonVioletColor">#B388FF</Color>
    <Color x:Key="CyberTextColor">#C8D3E0</Color>
    <Color x:Key="CyberTextBrightColor">#E6EEF7</Color>
    <Color x:Key="CyberDimColor">#5E6B80</Color>

    <SolidColorBrush x:Key="CyberBg" Color="{StaticResource CyberBgColor}" />
    <SolidColorBrush x:Key="CyberPanel" Color="{StaticResource CyberPanelColor}" />
    <SolidColorBrush x:Key="CyberPanelEdge" Color="{StaticResource CyberPanelEdgeColor}" />
    <SolidColorBrush x:Key="NeonCyan" Color="{StaticResource NeonCyanColor}" />
    <SolidColorBrush x:Key="NeonGreen" Color="{StaticResource NeonGreenColor}" />
    <SolidColorBrush x:Key="NeonMagenta" Color="{StaticResource NeonMagentaColor}" />
    <SolidColorBrush x:Key="NeonAmber" Color="{StaticResource NeonAmberColor}" />
    <SolidColorBrush x:Key="NeonViolet" Color="{StaticResource NeonVioletColor}" />
    <SolidColorBrush x:Key="CyberText" Color="{StaticResource CyberTextColor}" />
    <!-- branco so onde a voz sobe: titulo de card selecionado, texto digitado -->
    <SolidColorBrush x:Key="CyberTextBright" Color="{StaticResource CyberTextBrightColor}" />
    <SolidColorBrush x:Key="CyberDim" Color="{StaticResource CyberDimColor}" />

    <SolidColorBrush x:Key="NeonCyanGlow" Color="{StaticResource NeonCyanColor}" Opacity="0.25" />
    <SolidColorBrush x:Key="NeonGreenGlow" Color="{StaticResource NeonGreenColor}" Opacity="0.30" />
    <SolidColorBrush x:Key="NeonMagentaGlow" Color="{StaticResource NeonMagentaColor}" Opacity="0.30" />
    <SolidColorBrush x:Key="NeonAmberGlow" Color="{StaticResource NeonAmberColor}" Opacity="0.30" />

    <!-- brasa de fundo: um unico foco de luz roxa atras de tudo, bem baixo. Usado numa camada da janela. -->
    <RadialGradientBrush x:Key="CyberEmber" Center="0.5,0.32" RadiusX="0.62" RadiusY="0.62" GradientOrigin="0.5,0.32">
        <GradientStop Color="#3B1E7A" Offset="0" />
        <GradientStop Color="#1E1140" Offset="0.45" />
        <GradientStop Color="#000A0E14" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas</FontFamily>

    <!-- ===== Ritmo: multiplos de 4; respiro entre regioes 20-28 ===== -->
    <Thickness x:Key="PagePadding">28,20,28,28</Thickness>
    <x:Double x:Key="SectionGap">20</x:Double>
    <x:Double x:Key="BandGap">28</x:Double>
    <x:Double x:Key="TileGap">16</x:Double>
    <x:Double x:Key="TileIconSize">48</x:Double>
    <CornerRadius x:Key="TileRadius">10</CornerRadius>
    <CornerRadius x:Key="TileIconRadius">10</CornerRadius>

    <!-- ===== Tipografia: poucos tamanhos, muito contraste ===== -->
    <!-- 26 largo e espacado: um por tela -->
    <Style x:Key="CyberTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
        <Setter Property="CharacterSpacing" Value="200" />
    </Style>

    <!-- 17 (15 em tile) -->
    <Style x:Key="CyberHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CyberText}" />
        <Setter Property="CharacterSpacing" Value="100" />
    </Style>

    <Style x:Key="CyberTileHeading" TargetType="TextBlock" BasedOn="{StaticResource CyberHeading}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 13 corpo mono -->
    <Style x:Key="CyberBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CyberText}" />
    </Style>

    <!-- 12 legenda sussurrada -->
    <Style x:Key="CyberCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CyberDim}" />
    </Style>

    <!-- 10 espacado: rotulo de canto (^1, APP, PT, ATUAL). Nao e texto de leitura. -->
    <Style x:Key="CyberLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{StaticResource CyberDim}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== modo console (cards do canvas de PROJETOS): denso, tres tamanhos e so ===== -->
    <!-- 14: titulo de card. Neutro por padrao; o card que tem UM acento pinta o titulo com ele. -->
    <Style x:Key="CyberNodeTitle" TargetType="TextBlock" BasedOn="{StaticResource CyberHeading}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- 12: texto de console (STATUS.md, git, pasta): quebra e deixa selecionar -->
    <Style x:Key="CyberConsole" TargetType="TextBlock" BasedOn="{StaticResource CyberBody}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <!-- 11: legenda de console (meta de sessao, detalhe de processo) -->
    <Style x:Key="CyberMicro" TargetType="TextBlock" BasedOn="{StaticResource CyberCaption}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- rotulo de faixa/secao: 13px, espacado, na cor do acento (a cor vem por binding) -->
    <Style x:Key="CyberKicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="250" />
        <Setter Property="Foreground" Value="{StaticResource CyberDim}" />
    </Style>

    <!-- ===== Painel (card de console) ===== -->
    <Style x:Key="CyberCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CyberPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CyberCardAccent" TargetType="Border" BasedOn="{StaticResource CyberCard}">
        <Setter Property="BorderBrush" Value="{StaticResource NeonCyanGlow}" />
    </Style>

    <!-- aviso (falta configuracao, manifesto ausente): aresta ambar, nao ciano — ciano e "vivo agora" -->
    <Style x:Key="CyberCardWarn" TargetType="Border" BasedOn="{StaticResource CyberCard}">
        <Setter Property="BorderBrush" Value="{StaticResource NeonAmberGlow}" />
    </Style>

    <!-- chip de estado: LED + uma frase, sempre no mesmo canto. Fundo do painel, aresta de 1 px. -->
    <Style x:Key="CyberChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CyberPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===== Botão de fliperama ===== -->
    <Style x:Key="ArcadeButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="ArcadeButtonDanger" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonMagenta}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonMagenta}" />
    </Style>

    <Style x:Key="ArcadeButtonGo" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonGreen}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonGreen}" />
    </Style>

    <!-- secundario dentro de card / barra: mesmo desenho, menor -->
    <Style x:Key="ArcadeButtonSmall" TargetType="Button" BasedOn="{StaticResource ArcadeButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- fantasma: icone-so, sem borda; ganha borda so no hover (template do sistema). Player, recarregar, fechar. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CyberDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- ===== Tile de app / documento (grid das telas APPS e VIDA) ===== -->
    <Style x:Key="AppTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CyberPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="144" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- caixa do icone do tile: mesma medida e raio em APPS e VIDA; a cor vem do AccentGlow -->
    <Style x:Key="TileIconBox" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource TileIconSize}" />
        <Setter Property="Height" Value="{StaticResource TileIconSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource TileIconRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- botao miniatura dentro do tile (reordenar / tirar) -->
    <Style x:Key="TileMini" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CyberDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="TileMiniDanger" TargetType="Button" BasedOn="{StaticResource TileMini}">
        <Setter Property="Foreground" Value="{StaticResource NeonMagenta}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonMagentaGlow}" />
    </Style>

    <!-- Slider e ProgressBar do painel: track fino, cantos de raio 2 (bloco, nao pilula), acento ciano/ambar.
         SliderThumbCornerRadius/SliderTrackCornerRadius sao os ThemeResources que o template do WinUI 3 le. -->
    <CornerRadius x:Key="SliderThumbCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="SliderTrackCornerRadius">2</CornerRadius>
    <Style x:Key="CyberSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource NeonCyan}" />
        <Setter Property="Background" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- ComboBox do painel: mono, caixa escura, aresta 1 px, raio 4 (mesma familia da caixa de comando) -->
    <Style x:Key="CyberCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CyberTextBright}" />
        <Setter Property="Background" Value="{StaticResource CyberBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="CyberProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource NeonAmber}" />
        <Setter Property="Background" Value="{StaticResource CyberPanelEdge}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
</ResourceDictionary>
