<Page
    x:Class="Factory.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models">

    <!-- Ctrl+1..9 abre o tile pela ordem do grid -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="Hotkey_Invoked" />
        <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="Hotkey_Invoked" />
    </Page.KeyboardAccelerators>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="{StaticResource SectionGap}" MaxWidth="1500" HorizontalAlignment="Left">

            <!-- cabecalho: dia + acoes -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="// APPS" Style="{StaticResource CyberTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" Style="{StaticResource CyberBody}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="20" Height="20" />
                    <Button Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.DailyBriefingCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Not}}"
                            ToolTipService.ToolTip="proximas acoes e bloqueios dos projetos, na sua voz. Gera 1x por dia (gasta credito); depois e so play.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                            <TextBlock Text="OUVIR BRIEFING" />
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Bind ViewModel.EditLabel, Mode=OneWay}" Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.ToggleEditCommand}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.BriefingStatus, Mode=OneWay}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonAmber}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- faixas: uma por grupo, cor da faixa no titulo e no icone dos tiles -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="{StaticResource BandGap}" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:AppGroup">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="4" Height="18" CornerRadius="2" Background="{x:Bind Accent, Converter={StaticResource AccentBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberKicker}"
                                           Foreground="{x:Bind Accent, Converter={StaticResource AccentBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind Tiles}" ElementPrepared="Tiles_ElementPrepared">
                                <ItemsRepeater.Layout>
                                    <!-- 176 = padding 32 + icone 48 + 12 + titulo 22 + 4 + 2 linhas de legenda (~40) + folga. UniformGridLayout
                                         fixa a altura em MinItemHeight: se o conteudo passar disso, corta.
                                         Mesma largura minima e mesmo respiro (TileGap) da tela VIDA. -->
                                    <UniformGridLayout MinItemWidth="232" MinItemHeight="176" MinRowSpacing="{StaticResource TileGap}" MinColumnSpacing="{StaticResource TileGap}" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AppTile">
                                        <Border Style="{StaticResource AppTile}" Tag="{x:Bind}" IsTabStop="True"
                                                Tapped="Tile_Tapped" KeyDown="Tile_KeyDown"
                                                PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
                                                PointerPressed="Tile_PointerPressed" PointerReleased="Tile_PointerReleased"
                                                PointerCanceled="Tile_PointerReleased" PointerCaptureLost="Tile_PointerReleased">
                                            <!-- ESCOLHER: setas movem o tile; ele desliza pro lugar novo em vez de pular -->
                                            <Border.Transitions>
                                                <TransitionCollection>
                                                    <RepositionThemeTransition />
                                                </TransitionCollection>
                                            </Border.Transitions>
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Abrir" Tag="{x:Bind}" Click="MenuOpen_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Pasta no Explorer" Tag="{x:Bind}" Click="MenuFolder_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Terminal aqui" Tag="{x:Bind}" Click="MenuTerminal_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Claude aqui" Tag="{x:Bind}" Click="MenuClaude_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copiar caminho" Tag="{x:Bind}" Click="MenuCopy_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Border Style="{StaticResource TileIconBox}"
                                                            Background="{x:Bind Accent, Mode=OneWay, Converter={StaticResource AccentGlow}}">
                                                        <Grid>
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="{x:Bind Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}"
                                                                      Visibility="{x:Bind NoIcon, Mode=OneWay}" />
                                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" Stretch="Uniform"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- canto superior direito: tipo + LED (normal) ou setas + tirar (ESCOLHER). Mesma altura nos dois modos. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind NotEditing, Mode=OneWay}">
                                                        <!-- rotulos de canto (^N = Ctrl+N abre; app/script/web): CyberLabel, nao texto de leitura -->
                                                        <TextBlock Text="{x:Bind HotkeyText, Mode=OneWay}" Style="{StaticResource CyberLabel}"
                                                                   Foreground="{x:Bind Accent, Mode=OneWay, Converter={StaticResource AccentBrush}}" Visibility="{x:Bind HasHotkey, Mode=OneWay}"
                                                                   ToolTipService.ToolTip="atalho: Ctrl + numero" />
                                                        <TextBlock Text="{x:Bind KindLabel}" Style="{StaticResource CyberLabel}" />
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource RunningBrush}}"
                                                                 Opacity="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource LiveOpacity}}"
                                                                 ToolTipService.ToolTip="verde = rodando agora" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{x:Bind Editing, Mode=OneWay}">
                                                        <Button Style="{StaticResource TileMini}" Tag="{x:Bind}" Click="MoveUp_Click" ToolTipService.ToolTip="mover pra tras (na faixa)">
                                                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource TileMini}" Tag="{x:Bind}" Click="MoveDown_Click" ToolTipService.ToolTip="mover pra frente (na faixa)">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource TileMiniDanger}" Tag="{x:Bind}" Click="Remove_Click" ToolTipService.ToolTip="tirar do grid">
                                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- alinhado no TOPO: se algum dia faltar altura, corta o fim da legenda, nunca o titulo -->
                                                <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberTileHeading}" />
                                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                                                    <!-- ESCOLHER: faixa do tile (digite um nome novo pra criar faixa) -->
                                                    <ComboBox IsEditable="True" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                              PlaceholderText="faixa…" Tag="{x:Bind}"
                                                              ItemsSource="{x:Bind GroupOptions, Mode=OneWay}" Text="{x:Bind Group, Mode=OneWay}"
                                                              SelectionChanged="Group_SelectionChanged" TextSubmitted="Group_TextSubmitted"
                                                              Visibility="{x:Bind Editing, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- escolher -->
            <Border x:Name="EditCard" Style="{StaticResource CyberCardAccent}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="ESCOLHER APPS" Style="{StaticResource CyberHeading}" />
                            <TextBlock Style="{StaticResource CyberCaption}" TextWrapping="Wrap">
                                <Run Text="so projetos nossos. Marcado = no grid. No tile: setas reordenam na faixa, ✕ tira, o seletor muda a faixa (nome novo cria faixa). Guardado em " /><Run Text="{x:Bind ViewModel.ConfigFile}" Foreground="{StaticResource NeonCyan}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <ProgressRing IsActive="{x:Bind ViewModel.LoadingCandidates, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="18" Height="18" />
                            <!-- secundarios dentro de card: ArcadeButtonSmall (11 px), mesmo tamanho usado no ESTUDIO -->
                            <Button Content="+ ARQUIVO" Style="{StaticResource ArcadeButtonSmall}" Click="AddFile_Click" ToolTipService.ToolTip="qualquer .exe, .lnk, .cmd, .ps1, .py ou .url (fica mesmo sendo de fora da raiz de projetos)" />
                            <Button Content="RESTAURAR PADRAO" Style="{StaticResource ArcadeButtonDanger}" Padding="12,4" FontSize="11" Click="Reset_Click" ToolTipService.ToolTip="substitui o grid pelo inicial (pede confirmacao)" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="FilterBox" PlaceholderText="filtrar candidatos…" FontFamily="{StaticResource MonoFont}" MaxWidth="420" HorizontalAlignment="Left"
                             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredCandidates, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="340" MinItemHeight="34" MinRowSpacing="2" MinColumnSpacing="12" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:AppTile">
                                <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" Tag="{x:Bind}" Click="Candidate_Click" MinWidth="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Width="18" Height="18">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{StaticResource CyberDim}" Visibility="{x:Bind NoIcon, Mode=OneWay}" />
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource CyberText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
