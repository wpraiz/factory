<Page
    x:Class="Factory.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:helpers="using:Factory.Helpers">

    <Page.Resources>
        <!-- mesmo ChipButton do ProjectsPage: parece link, age como botao -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource CyberText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <DataTemplate x:Key="TermoChip" x:DataType="models:Chip">
            <Button Content="{x:Bind Label}" Style="{StaticResource ChipButton}" Command="{x:Bind Command}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}" />
        </DataTemplate>
        <!-- quebra linha de verdade (ui-review: StackPanel horizontal vazava chip pra fora da tela) -->
        <ItemsPanelTemplate x:Key="WrapPanel">
            <helpers:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Text="// BUSCA" Style="{StaticResource CyberTitle}" />
            <TextBlock Text="qualquer termo — em todas as sessoes do Claude (todas as pastas), memoria, wiki, .factory e raiz dos projetos"
                       Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="ex.: nome de projeto, tag, cliente…" FontFamily="{StaticResource MonoFont}"
                         Text="{x:Bind ViewModel.Term, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Term_KeyDown" />
                <Button Grid.Column="1" Content="⌕ BUSCAR" Style="{StaticResource ArcadeButtonGo}"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Not}}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="18" Height="18" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonAmber}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.LimparCommand}"
                        Visibility="{x:Bind ViewModel.Buscou, Mode=OneWay}" ToolTipService.ToolTip="limpar e voltar pras sugestoes">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- ===== estado vazio: nunca abre em branco ===== -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.NaoBuscou, Mode=OneWay}">
                <TextBlock Text="carregando sugestoes (o catalogo ainda esta sendo lido)…" Style="{StaticResource CyberCaption}"
                           Visibility="{x:Bind ViewModel.SemSugestoes, Mode=OneWay}" />
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TemRecentes, Mode=OneWay}">
                    <TextBlock Text="BUSCAS RECENTES" Style="{StaticResource CyberKicker}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recentes}" ItemTemplate="{StaticResource TermoChip}" ItemsPanel="{StaticResource WrapPanel}" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TemSugestoes, Mode=OneWay}">
                    <TextBlock Text="PROJETOS TOCADOS POR ULTIMO — clique abre o projeto" Style="{StaticResource CyberKicker}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SugestoesProjetos}" ItemTemplate="{StaticResource TermoChip}" ItemsPanel="{StaticResource WrapPanel}" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TemSugestoes, Mode=OneWay}">
                    <TextBlock Text="TAGS MAIS USADAS — clique busca" Style="{StaticResource CyberKicker}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SugestoesTags}" ItemTemplate="{StaticResource TermoChip}" ItemsPanel="{StaticResource WrapPanel}" />
                </StackPanel>
                <TextBlock Style="{StaticResource CyberCaption}" TextWrapping="Wrap"
                           Text="Enter busca · vale nome de projeto, cliente, tag, trecho de conversa ou nome de arquivo · Ctrl+K abre a palette de qualquer tela" />
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Buscou, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ProjectsText, Mode=OneWay}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonCyan}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.ProjectMatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Chip">
                            <Button Content="{x:Bind Text}" Style="{StaticResource ArcadeButtonGo}" Padding="10,4" FontSize="12" Command="{x:Bind Command}" ToolTipService.ToolTip="{x:Bind Tooltip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Style="{StaticResource CyberCard}" Visibility="{x:Bind ViewModel.Buscou, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="SESSOES" Style="{StaticResource CyberHeading}" />
                    <TextBlock Text="{x:Bind ViewModel.SessionsText, Mode=OneWay}" Style="{StaticResource CyberCaption}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionInfo">
                                <Grid Padding="0,6" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="↗ PROJETO" Style="{StaticResource ArcadeButton}" Padding="10,4" FontSize="11"
                                            Command="{x:Bind GoCommand}" Visibility="{x:Bind HasGo}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="▶ RETOMAR" Style="{StaticResource ArcadeButtonGo}" Padding="10,4" FontSize="11"
                                            Command="{x:Bind ResumeCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CyberCard}" Visibility="{x:Bind ViewModel.Buscou, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ARQUIVOS" Style="{StaticResource CyberHeading}" />
                    <TextBlock Text="{x:Bind ViewModel.DocsText, Mode=OneWay}" Style="{StaticResource CyberCaption}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Docs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MentionHit">
                                <Grid Padding="0,6" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonCyan}" />
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CyberCaption}" />
                                        <TextBlock Text="{x:Bind Snippet}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource CyberText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="↗ PROJETO" Style="{StaticResource ArcadeButton}" Padding="10,4" FontSize="11"
                                            Command="{x:Bind GoCommand}" Visibility="{x:Bind HasGo}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="ABRIR" Style="{StaticResource ArcadeButton}" Padding="10,4" FontSize="11"
                                            Command="{x:Bind OpenCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
