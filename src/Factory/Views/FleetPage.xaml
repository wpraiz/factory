<Page
    x:Class="Factory.Views.FleetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models">

    <Page.Resources>
        <!-- mesmo TinyButton do ProjectsPage (ArcadeButtonSmall mais compacto): acao de linha,
             nunca verde — verde e so pra acao principal de secao, e aqui nao ha uma unica. -->
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource ArcadeButtonSmall}">
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <DataTemplate x:Key="FleetRowTemplate" x:DataType="models:FleetRow">
            <Grid Padding="0,8" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LED: unico sinal de estado (guia: estado e LED/borda, nao texto colorido tambem) -->
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{x:Bind HasLive, Mode=OneWay, Converter={StaticResource RunningBrush}}"
                         Opacity="{x:Bind HasLive, Mode=OneWay, Converter={StaticResource LiveOpacity}}"
                         ToolTipService.ToolTip="verde = sessao ativa agora" />

                <!-- nome sozinho na 1a linha: precisa ser o unico child do StackPanel vertical
                     pra TextTrimming funcionar (StackPanel horizontal mede child com largura
                     infinita — bug apontado no ux-review). Tags/status juntos na 2a linha. -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CyberCaption}" />
                        <TextBlock Text="cliente" Style="{StaticResource CyberLabel}" Foreground="{StaticResource CyberDim}" Visibility="{x:Bind IsCliente}" />
                        <TextBlock Text="não catalogado" Style="{StaticResource CyberLabel}" Foreground="{StaticResource CyberDim}" Visibility="{x:Bind IsOrphan}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="▶ RETOMAR" Style="{StaticResource TinyButton}"
                            Tag="{x:Bind}" Click="Resume_Click"
                            Visibility="{x:Bind HasSession, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ResumeTooltip, Mode=OneWay}" />
                    <Button Content="+ NOVA" Style="{StaticResource TinyButton}"
                            Tag="{x:Bind}" Click="Launch_Click" Visibility="{x:Bind HasNone, Mode=OneWay}" />
                    <Button Style="{StaticResource GhostButton}" Tag="{x:Bind}" Click="Terminal_Click" ToolTipService.ToolTip="terminal">
                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Tag="{x:Bind}" Click="Folder_Click" ToolTipService.ToolTip="pasta">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="// FROTA" Style="{StaticResource CyberTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.RescanCommand.IsRunning, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.RescanCommand.IsRunning, Mode=OneWay}"
                              Foreground="{StaticResource NeonCyan}" Width="18" Height="18" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.RescanCommand}"
                        IsEnabled="{x:Bind ViewModel.RescanCommand.IsRunning, Mode=OneWay, Converter={StaticResource Not}}"
                        VerticalAlignment="Top" ToolTipService.ToolTip="reler a raiz de projetos">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- o squad do Odin (Odin + 3 agentes + vigia), cada um com a propria orb. Fora do ScrollViewer: o WebView2
                 nao rola junto com o resto. Estado vem de OdinHands.TrabalhandoAgora() e do vigia, a cada 1 s. -->
            <Border Grid.Row="1" Height="280" MaxWidth="1000" HorizontalAlignment="Left" Width="1000" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="1" CornerRadius="6">
                <WebView2 x:Name="SquadView" DefaultBackgroundColor="#0A0E14" />
            </Border>

        <ScrollViewer Grid.Row="2">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="nenhum projeto encontrado — clique RESCAN" Style="{StaticResource CyberCaption}"
                       Visibility="{x:Bind ViewModel.NoRows, Mode=OneWay}" />

            <!-- faixas de tempo: cabecalho so aparece se a faixa tiver linha; ANTES fica recolhida -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.TemVivos, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.VivosTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Vivos}" ItemTemplate="{StaticResource FleetRowTemplate}" />
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.TemHoje, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.HojeTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Hoje}" ItemTemplate="{StaticResource FleetRowTemplate}" />
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.TemSemana, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.SemanaTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Semana}" ItemTemplate="{StaticResource FleetRowTemplate}" />
            </StackPanel>
            <!-- recolhivel proprio (o Expander do sistema destoava do tema — ui-review) -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.TemAntes, Mode=OneWay}">
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.AlternarAntesCommand}" Padding="0,4"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="mostrar/esconder projetos sem sessao nesta semana">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.AntesTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" VerticalAlignment="Center" />
                        <FontIcon Glyph="{x:Bind ViewModel.AntesChevron, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Antes}" ItemTemplate="{StaticResource FleetRowTemplate}"
                              Visibility="{x:Bind ViewModel.AntesAberto, Mode=OneWay}" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
