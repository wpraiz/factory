<Page
    x:Class="Factory.Views.MoneyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:vm="using:Factory.ViewModels">

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Left">

            <TextBlock Text="// GRANA" Style="{StaticResource CyberTitle}" />
            <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}" TextWrapping="Wrap" />
            <TextBlock Text="Fonte: factory.json de cada projeto (canvas do projeto › MANIFESTO). O painel nao inventa numero — so mostra o que voce declarou."
                       Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />

            <!-- ===== mapa potencial x esforco ===== -->
            <Border Style="{StaticResource CyberCardAccent}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="MAPA :: POTENCIAL × ESFORCO" Style="{StaticResource CyberHeading}" VerticalAlignment="Center" />
                        <ToggleSwitch HorizontalAlignment="Right" OffContent="ICE" OnContent="RICE (× alcance)" FontFamily="{StaticResource MonoFont}" FontSize="12" MinWidth="0"
                                      IsOn="{x:Bind ViewModel.UseRice, Mode=TwoWay}" ToolTipService.ToolTip="ICE = potencial × confianca ÷ esforco · RICE multiplica pelo alcance" />
                    </Grid>
                    <TextBlock Text="tamanho do ponto = confianca (o que ja e real fica grande) · anel verde = 1º real em ate 14 dias · clique abre o projeto" Style="{StaticResource CyberCaption}" />
                    <Canvas x:Name="Plot" Width="816" Height="556" HorizontalAlignment="Left">
                        <!-- fundo + quadrantes -->
                        <Rectangle Canvas.Left="48" Canvas.Top="48" Width="720" Height="460" Fill="{StaticResource CyberBg}" Stroke="{StaticResource CyberPanelEdge}" StrokeThickness="1" />
                        <Line X1="408" Y1="48" X2="408" Y2="508" Stroke="{StaticResource CyberPanelEdge}" StrokeThickness="1" StrokeDashArray="4,4" />
                        <Line X1="48" Y1="278" X2="768" Y2="278" Stroke="{StaticResource CyberPanelEdge}" StrokeThickness="1" StrokeDashArray="4,4" />
                        <TextBlock Canvas.Left="58" Canvas.Top="54" Text="FAZER JA — alto potencial, pouco esforco" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonGreen}" />
                        <TextBlock Canvas.Left="418" Canvas.Top="54" Text="APOSTA GRANDE — alto potencial, muito esforco" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="58" Canvas.Top="488" Text="RAPIDO MAS PEQUENO" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="418" Canvas.Top="488" Text="EVITAR — pouco potencial, muito esforco" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonMagenta}" />
                        <!-- eixos -->
                        <TextBlock Canvas.Left="48" Canvas.Top="516" Text="esforco →  1" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="748" Canvas.Top="516" Text="5" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="6" Canvas.Top="48" Text="5" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="6" Canvas.Top="494" Text="1" Style="{StaticResource CyberCaption}" />
                        <TextBlock Canvas.Left="2" Canvas.Top="260" Text="pot." Style="{StaticResource CyberCaption}" />
                        <!-- pontos entram por codigo (DrawDots) -->
                        <Canvas x:Name="DotsLayer" />
                    </Canvas>
                    <TextBlock x:Name="PlotEmpty" Text="nenhum projeto avaliado ainda — abra um projeto no canvas, preencha potencial e esforco no MANIFESTO e salve"
                               Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonAmber}" />
                </StackPanel>
            </Border>

            <!-- ===== ranking ===== -->
            <Border Style="{StaticResource CyberCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="MELHOR R$ POR ESFORCO" Style="{StaticResource CyberHeading}" Foreground="{StaticResource NeonGreen}" />
                    <TextBlock Text="{x:Bind ViewModel.RankingText, Mode=OneWay}" Style="{StaticResource CyberCaption}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Ranking}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MoneyRow">
                                <Grid Padding="0,6" ColumnSpacing="14" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Stars}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonGreen}" VerticalAlignment="Center">
                                        <Run Text="{x:Bind ScoreText}" /><Run Text=" " /><Run Text="{x:Bind Soon}" Foreground="{StaticResource NeonAmber}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Revenue}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource CyberCaption}" VerticalAlignment="Center">
                                        <Run Text="{x:Bind Model}" /><Run Text=" · " /><Run Text="{x:Bind Stage}" />
                                    </TextBlock>
                                    <Button Grid.Column="6" Content="↗" Style="{StaticResource ArcadeButton}" Padding="8,2" FontSize="11" Command="{x:Bind GoCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== por estagio ===== -->
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageGroup">
                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Header}" Style="{StaticResource CyberHeading}" Foreground="{StaticResource NeonGreen}" />
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectInfo">
                                            <Grid Padding="0,6" ColumnSpacing="14" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind KindText, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind PotentialText, Mode=OneWay}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}" />
                                                    <TextBlock Text="{x:Bind MoneyText, Mode=OneWay}" Style="{StaticResource CyberCaption}" />
                                                    <TextBlock Text="{x:Bind TagsText, Mode=OneWay}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonMagenta}" Visibility="{x:Bind HasTags, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="URL" Style="{StaticResource ArcadeButton}" Padding="8,3" FontSize="11"
                                                        Visibility="{x:Bind HasUrl, Mode=OneWay}" Tag="{x:Bind}" Click="OpenUrl_Click" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Content="↗" Style="{StaticResource ArcadeButton}" Padding="8,3" FontSize="11"
                                                        Tag="{x:Bind}" Click="GoTo_Click" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
