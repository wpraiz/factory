<Page
    x:Class="Factory.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:vm="using:Factory.ViewModels"
    xmlns:helpers="using:Factory.Helpers">

    <!-- Seguranca (redesign from the dashboard research in docs\pesquisa-dashboards\):
         grade unica 8|4 em todas as abas (lista a esquerda, painel a direita), linha de lista com colunas FIXAS
         (estado 104 | texto * | acao 128 | ? 28 | menu 28), evidencia fora da linha (painel de detalhe), 5 estilos de texto,
         sans pro texto e mono so pra dado. Controles prontos: ListView, TextBox, Expander, MenuFlyout. -->
    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- tema SO desta tela (o resto do Factory continua no Cyber.xaml original) -->
            <ResourceDictionary Source="ms-appx:///Themes/SecurityTheme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <helpers:SegAccentBrushConverter x:Key="AccentBrush" />
        <helpers:SegAccentGlowConverter x:Key="AccentGlow" />
        <!-- item de lista: estica, linha separadora de 1 px embaixo (divisao), altura minima 48 -->
        <Style x:Key="SecItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
        </Style>

        <!-- cabecalho de grupo: rotulo + contagem, com linha embaixo e respiro em cima -->
        <DataTemplate x:Key="SecGrupoHeader" x:DataType="vm:SecGrupo">
            <Border BorderBrush="{StaticResource CyberControlEdge}" BorderThickness="0,0,0,1" Padding="8,12,8,6">
                <TextBlock Text="{x:Bind Cabecalho}" Style="{StaticResource CyberLabel}" Foreground="{StaticResource CyberTextBright}" />
            </Border>
        </DataTemplate>

        <!-- container do cabecalho de grupo: o nativo traz Padding 12,8 + MinHeight 44 + divisor proprio (linha dupla e buraco) -->
        <Style x:Key="SecHeaderItemStyle" TargetType="ListViewHeaderItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UMA linha de achado: [estado] [titulo + o que eu faria] [acao principal] [?] [...] -->
        <DataTemplate x:Key="SecRowTemplate" x:DataType="models:SecRow">
            <Grid ColumnSpacing="12" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border Width="88" CornerRadius="4" Padding="0,3" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{x:Bind Accent, Converter={StaticResource AccentGlow}}"
                        BorderBrush="{x:Bind Accent, Converter={StaticResource AccentBrush}}">
                    <TextBlock Text="{x:Bind Estado}" Style="{StaticResource CyberLabel}" HorizontalAlignment="Center" Foreground="{x:Bind Accent, Converter={StaticResource AccentBrush}}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,6">
                    <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Opiniao}" Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Opiniao}"
                               Visibility="{x:Bind Opiniao, Converter={StaticResource HasText}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{x:Bind PrimariaTexto}" Style="{StaticResource ArcadeButtonSmall}" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Tag="{x:Bind}" Click="Primario_Click" Visibility="{x:Bind TemPrimaria}" ToolTipService.ToolTip="{x:Bind PrimariaEfeito}" />
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Tag="{x:Bind}" Click="PorQue_Click" Visibility="{x:Bind MostrarOQueE}"
                        ToolTipService.ToolTip="O que é isso?" AutomationProperties.Name="O que é isso?">
                    <FontIcon Glyph="&#xE897;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource GhostButton}" VerticalAlignment="Center" ToolTipService.ToolTip="mais ações" AutomationProperties.Name="mais ações" Visibility="{x:Bind TemMenu}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="O que é isso?" Tag="{x:Bind}" Click="PorQue_Click" Visibility="{x:Bind PodePorQue}" />
                            <MenuFlyoutItem Text="Perguntar ao squad" Tag="{x:Bind}" Click="PerguntarSquad_Click" Visibility="{x:Bind PodePorQue}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Ignorar" Tag="{x:Bind}" Click="Aprovar_Click" Visibility="{x:Bind PodeAprovar}" />
                            <MenuFlyoutItem Text="{x:Bind CorteMenu}" Tag="{x:Bind}" Click="Cortar_Click" Visibility="{x:Bind PodeCortar}" />
                            <MenuFlyoutItem Text="{x:Bind ReverteMenu}" Tag="{x:Bind}" Click="Reverter_Click" Visibility="{x:Bind PodeReverter}" />
                            <MenuFlyoutItem Text="Abrir no Windows" Tag="{x:Bind}" Click="AbrirWin_Click" Visibility="{x:Bind PodeAbrir}" />
                            <MenuFlyoutItem Text="Mostrar arquivo no Explorer" Tag="{x:Bind}" Click="Inspecionar_Click" Visibility="{x:Bind PodeInspecionar}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Alavanca de painel (AO VIVO / MOSTRAR TUDO / VIGIA) -->
        <Style x:Key="LeverSwitch" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                            <Grid Width="22" Height="34">
                                <Border Background="{StaticResource CyberWell}" BorderBrush="{StaticResource CyberControlEdge}" BorderThickness="1" CornerRadius="4" />
                                <Border x:Name="Knob" Width="16" Height="12" CornerRadius="3" VerticalAlignment="Bottom" Margin="0,0,0,3" Background="{StaticResource CyberDim}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobT" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CyberText}" />
                                <TextBlock x:Name="Estado" Text="desligado" FontSize="12" Foreground="{StaticResource CyberDim}" />
                            </StackPanel>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Background" Value="{StaticResource NeonCyan}" />
                                            <Setter Target="Estado.Text" Value="ligado" />
                                            <Setter Target="Estado.Foreground" Value="{StaticResource NeonCyan}" />
                                        </VisualState.Setters>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="Y" To="-15" Duration="0:0:0.15" /></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Background" Value="{StaticResource NeonCyan}" />
                                            <Setter Target="Estado.Text" Value="ligado" />
                                            <Setter Target="Estado.Foreground" Value="{StaticResource NeonCyan}" />
                                        </VisualState.Setters>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="Y" To="-15" Duration="0:0:0.15" /></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Background" Value="{StaticResource NeonCyan}" />
                                            <Setter Target="Estado.Text" Value="ligado" />
                                            <Setter Target="Estado.Foreground" Value="{StaticResource NeonCyan}" />
                                        </VisualState.Setters>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="Y" To="-15" Duration="0:0:0.15" /></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aba: texto + linha de 2 px (ativa) -->
        <Style x:Key="SecTab" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Padding="14,0" Height="36">
                            <ContentPresenter x:Name="Txt" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CyberDim}" />
                            <Border x:Name="Linha" Height="2" VerticalAlignment="Bottom" Background="{StaticResource NeonCyan}" Opacity="0" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Txt.Foreground" Value="{StaticResource CyberText}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Txt.Foreground" Value="{StaticResource CyberTextBright}" /><Setter Target="Linha.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Txt.Foreground" Value="{StaticResource CyberTextBright}" /><Setter Target="Linha.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Txt.Foreground" Value="{StaticResource CyberTextBright}" /><Setter Target="Linha.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SectionGap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABECALHO (igual em todas as abas): estado do PC + o que e global -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}">
                <TextBlock Text="Segurança" Style="{StaticResource CyberTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <!-- aviso discreto: so aparece com alerta nao visto; clicar leva aos alertas -->
                <HyperlinkButton Padding="0" VerticalAlignment="Center" Tag="aba:2" Click="IrLink_Click"
                                 Visibility="{x:Bind ViewModel.AlertaPendente, Mode=OneWay}" ToolTipService.ToolTip="ver os alertas do vigia">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource NeonAmber}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TabAlertas, Mode=OneWay}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}" />
                    </StackPanel>
                </HyperlinkButton>
                <ToggleButton Content="Ao vivo" Style="{StaticResource LeverSwitch}" Visibility="{x:Bind ViewModel.Aba0, Mode=OneWay}" IsChecked="{x:Bind ViewModel.AoVivo, Mode=TwoWay}"
                              ToolTipService.ToolTip="graficos de rede, conexoes e processos a cada 1 s (so com a tela aberta)" />
                <ToggleButton Content="Mostrar tudo" Style="{StaticResource LeverSwitch}" Visibility="{x:Bind ViewModel.Aba1, Mode=OneWay}" IsChecked="{x:Bind ViewModel.MostrarWindows, Mode=TwoWay}"
                              ToolTipService.ToolTip="ACHADOS: inclui o que e do Windows e o que voce ja marcou como ignorado" />
                <ToggleButton Content="Vigia" Style="{StaticResource LeverSwitch}" IsChecked="{x:Bind ViewModel.VigiaLigada, Mode=TwoWay}"
                              ToolTipService.ToolTip="monitoramento continuo em segundo plano: aumento anomalo, repeticao, item novo, protecao que desligou. So le." />
                <ProgressRing IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="18" Height="18" />
                <Button Content="Desfazer" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.DesfazerCommand}"
                        Visibility="{x:Bind ViewModel.PodeDesfazer, Mode=OneWay}"
                        ToolTipService.ToolTip="tira da lista de ignorados o que o ultimo IGNORAR gravou" />
                <Button Content="Ler agora" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.Loading, Mode=OneWay, Converter={StaticResource Not}}"
                        ToolTipService.ToolTip="le o Windows de novo (~5 s, PowerShell escondido, sem admin) · F5">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ABAS (esquerda) + alavancas (direita) -->
        <Border Grid.Row="1" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="-14,0,0,0">
                    <ToggleButton Content="Painel" Style="{StaticResource SecTab}" Tag="0" Click="Tab_Click" IsChecked="{x:Bind ViewModel.Aba0, Mode=OneWay}" />
                    <ToggleButton Content="{x:Bind ViewModel.TabAchados, Mode=OneWay}" Style="{StaticResource SecTab}" Tag="1" Click="Tab_Click" IsChecked="{x:Bind ViewModel.Aba1, Mode=OneWay}" />
                    <ToggleButton Content="{x:Bind ViewModel.TabAlertas, Mode=OneWay}" Style="{StaticResource SecTab}" Tag="2" Click="Tab_Click" IsChecked="{x:Bind ViewModel.Aba2, Mode=OneWay}" />
                    <ToggleButton Content="{x:Bind ViewModel.TabHardening, Mode=OneWay}" Style="{StaticResource SecTab}" Tag="4" Click="Tab_Click" IsChecked="{x:Bind ViewModel.Aba4, Mode=OneWay}" />
                    <ToggleButton Content="Squad" Style="{StaticResource SecTab}" Tag="5" Click="Tab_Click" IsChecked="{x:Bind ViewModel.Aba5, Mode=OneWay}" />
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <!-- ============ 0 · VISAO GERAL: anunciadores em cima; 8 = o que exige atencao; 4 = telemetria ao vivo ============ -->
            <Grid RowSpacing="{StaticResource SectionGap}" Visibility="{x:Bind ViewModel.Aba0, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Protecoes: faixa de ESTADO (nao e seletor): ponto + nome + valor, sem caixa, pra nao parecer aba da lista de baixo -->
                <Border Style="{StaticResource CyberCard}" Padding="16,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Proteções" Style="{StaticResource CyberHeading}" VerticalAlignment="Center" />
                        <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Badges}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:SecBadge">
                                        <Grid Width="150" ColumnSpacing="8" Background="Transparent" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{x:Bind Dica}" Tag="{x:Bind}" Tapped="Selo_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{x:Bind Led}" Stroke="{x:Bind LedAro}" StrokeThickness="1" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Rotulo}" Style="{StaticResource CyberLabel}" Foreground="{StaticResource CyberText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Valor}" Style="{StaticResource CyberCaption}" Foreground="{x:Bind Tinta}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="{StaticResource TileGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="440" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CyberCard}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Atenção agora" Style="{StaticResource CyberHeading}" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                                                 Command="{x:Bind ViewModel.VerAchadosCommand}" Visibility="{x:Bind ViewModel.AtencaoTemMais, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonCyan}">
                                        <Run Text="Ver todos os achados (+" /><Run Text="{x:Bind ViewModel.AtencaoMais, Mode=OneWay}" /><Run Text=") →" />
                                    </TextBlock>
                                </HyperlinkButton>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.AtencaoVazio, Mode=OneWay}" Style="{StaticResource CyberBody}" VerticalAlignment="Top"
                                       Visibility="{x:Bind ViewModel.AtencaoVazio, Mode=OneWay, Converter={StaticResource HasText}}" />
                            <ListView x:Name="ListAtencao" Grid.Row="1" Margin="-8,0,-8,0" ItemTemplate="{StaticResource SecRowTemplate}" ItemContainerStyle="{StaticResource SecItemStyle}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Atencao_ItemClick">
                                <ListView.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource SecGrupoHeader}" HeaderContainerStyle="{StaticResource SecHeaderItemStyle}" HidesIfEmpty="True" />
                                </ListView.GroupStyle>
                            </ListView>

                        </Grid>
                    </Border>

                    <!-- 4 = 3 graficos EMPILHADOS, mesmo tamanho; clicar leva ao que importa -->
                    <Grid Grid.Column="1" RowSpacing="{StaticResource TileGap}" x:Name="LinhaTelemetria">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CyberCard}" Tag="achados:REDE" Tapped="Ir_Tapped" ToolTipService.ToolTip="clique: ver as portas abertas (Achados · Rede)">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rede" Style="{StaticResource CyberHeading}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="12" Height="3" CornerRadius="1" Background="{StaticResource ChartA}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CyberCaption}"><Run Text="entrada " /><Run Text="{x:Bind ViewModel.RedeIn, Mode=OneWay}" Foreground="{StaticResource CyberTextBright}" FontFamily="Cascadia Mono" /></TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="12" Height="3" CornerRadius="1" Background="{StaticResource ChartB}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CyberCaption}"><Run Text="saída " /><Run Text="{x:Bind ViewModel.RedeOut, Mode=OneWay}" Foreground="{StaticResource CyberTextBright}" FontFamily="Cascadia Mono" /></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <helpers:ScopeChart x:Name="ScopeRede" Grid.Row="1" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CyberCard}" Tag="achados:REDE" Tapped="Ir_Tapped" ToolTipService.ToolTip="clique: ver as portas abertas (Achados · Rede)">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Conexões" Style="{StaticResource CyberHeading}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CyberCaption}" HorizontalAlignment="Right">
                                        <Run Text="{x:Bind ViewModel.Conexoes, Mode=OneWay}" Foreground="{StaticResource CyberTextBright}" FontFamily="Cascadia Mono" /><Run Text="  abertas · " /><Run Text="{x:Bind ViewModel.ConexoesSub, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                                <helpers:ScopeChart x:Name="ScopeConexoes" Grid.Row="1" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CyberCard}" Tag="aba:2" Tapped="Ir_Tapped" ToolTipService.ToolTip="clique: ver os alertas do vigia">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Processos nascendo" Style="{StaticResource CyberHeading}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CyberCaption}" HorizontalAlignment="Right"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.NascidosLista, Mode=OneWay}">
                                        <Run Text="{x:Bind ViewModel.Nascidos, Mode=OneWay}" Foreground="{StaticResource CyberTextBright}" FontFamily="Cascadia Mono" /><Run Text="  no último minuto" />
                                    </TextBlock>
                                </Grid>
                                <helpers:ScopeChart x:Name="ScopeProcessos" Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ 1 · O QUE FAZER: lista inteira; o detalhe so abre quando ele escolhe um item ============ -->
            <Grid ColumnSpacing="{StaticResource TileGap}" Visibility="{x:Bind ViewModel.Aba1, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCard}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Falha, Mode=OneWay}" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}"
                                   TextWrapping="Wrap" Margin="8" Visibility="{x:Bind ViewModel.Falha, Mode=OneWay, Converter={StaticResource HasText}}" />
                        <Grid ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Achados" Style="{StaticResource CyberHeading}" />
                                <TextBlock Text="{x:Bind ViewModel.AchadosResumo, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <Button Content="{x:Bind ViewModel.FTudo, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.FiltrarCommand}" CommandParameter="TUDO" />
                                <Button Content="{x:Bind ViewModel.FRede, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.FiltrarCommand}" CommandParameter="REDE"
                                        ToolTipService.ToolTip="programas escutando conexoes vindas da rede" />
                                <Button Content="{x:Bind ViewModel.FInicia, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.FiltrarCommand}" CommandParameter="INICIA"
                                        ToolTipService.ToolTip="tarefas, chaves Run e pasta Inicializar" />
                                <Button Content="{x:Bind ViewModel.FDefender, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.FiltrarCommand}" CommandParameter="DEFENDER"
                                        ToolTipService.ToolTip="ameacas e bloqueios ASR das ultimas 24 h" />
                                <Button Content="{x:Bind ViewModel.FPostura, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.FiltrarCommand}" CommandParameter="POSTURA"
                                        ToolTipService.ToolTip="protecoes do Windows desligadas" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Nada pede você agora." Style="{StaticResource CyberBody}" VerticalAlignment="Top"
                                   Visibility="{x:Bind ViewModel.SemAchados, Mode=OneWay}" />
                        <ListView x:Name="ListAchados" Grid.Row="1" Margin="-8,0,-8,0" ItemTemplate="{StaticResource SecRowTemplate}"
                                  ItemContainerStyle="{StaticResource SecItemStyle}" SelectionMode="Single" SelectionChanged="Achados_SelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource SecGrupoHeader}" HeaderContainerStyle="{StaticResource SecHeaderItemStyle}" HidesIfEmpty="True" />
                            </ListView.GroupStyle>
                        </ListView>
                    </Grid>
                </Border>

                <!-- DETALHE: o que e, risco, o que eu faria, evidencia, nota do usuario e TODAS as acoes -->
                <Border Grid.Column="1" Style="{StaticResource CyberCard}" Width="440" Visibility="{x:Bind ViewModel.TemSelecao, Mode=OneWay}">
                    <Grid>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Canvas.ZIndex="1"
                                Command="{x:Bind ViewModel.FecharDetalheCommand}" ToolTipService.ToolTip="fechar" AutomationProperties.Name="fechar detalhe">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <StackPanel VerticalAlignment="Top" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Detalhe" Style="{StaticResource CyberHeading}" />
                            <TextBlock Text="Selecione um item da lista (ou toque no ?) pra ver o que é isso, o risco, o que eu faria, a evidência e anotar um lembrete." Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Visibility="{x:Bind ViewModel.TemSelecao, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Estado, Mode=OneWay}" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Titulo, Mode=OneWay}" Style="{StaticResource CyberHeading}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Isso é" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Parecer.Oque, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Risco" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Parecer.Risco, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="O que eu faria" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Parecer.Sugestao, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Evidência" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Selecionado.Detalhe, Mode=OneWay}" Style="{StaticResource CyberData}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Minha nota (fica salva)" Style="{StaticResource CyberLabel}" />
                                    <TextBox Text="{x:Bind ViewModel.SelecionadoNota, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                             PlaceholderText="ex.: desliguei de propósito porque…" LostFocus="Nota_LostFocus" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <Button Content="{x:Bind ViewModel.Selecionado.PrimariaTexto, Mode=OneWay}" Style="{StaticResource ArcadeButtonGo}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="Primario_Click" Visibility="{x:Bind ViewModel.Selecionado.TemPrimaria, Mode=OneWay}" />
                                    <Button Content="Ignorar (sei o que é)" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="Aprovar_Click" Visibility="{x:Bind ViewModel.Selecionado.ExtraAprovar, Mode=OneWay}"
                                            ToolTipService.ToolTip="so deixa de alertar sobre isto; nao muda nada no Windows. Desfazer fica no cabecalho." />
                                    <Button Content="{x:Bind ViewModel.Selecionado.CorteMenu, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="Cortar_Click" Visibility="{x:Bind ViewModel.Selecionado.ExtraCorte, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Selecionado.CorteDica, Mode=OneWay}" />
                                    <Button Content="{x:Bind ViewModel.Selecionado.ReverteMenu, Mode=OneWay}" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="Reverter_Click" Visibility="{x:Bind ViewModel.Selecionado.ExtraReverte, Mode=OneWay}" />
                                    <Button Content="Abrir no Windows" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="AbrirWin_Click" Visibility="{x:Bind ViewModel.Selecionado.ExtraAbrir, Mode=OneWay}" />
                                    <Button Content="Mostrar arquivo no Explorer" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="Inspecionar_Click" Visibility="{x:Bind ViewModel.Selecionado.PodeInspecionar, Mode=OneWay}" />
                                    <Button Content="Perguntar ao squad (gasta assinatura)" Style="{StaticResource ArcadeButtonSmall}" HorizontalAlignment="Stretch"
                                            Tag="{x:Bind ViewModel.Selecionado, Mode=OneWay}" Click="PerguntarSquad_Click" Visibility="{x:Bind ViewModel.Selecionado.PodePorQue, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 2 · ALERTAS: 8 = lista; 4 = vigia ============ -->
            <Grid ColumnSpacing="{StaticResource TileGap}" Visibility="{x:Bind ViewModel.Aba2, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCard}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Alertas do vigia" Style="{StaticResource CyberHeading}" />
                                <TextBlock Text="{x:Bind ViewModel.VigiaEstado, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Tudo visto" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.AlertasVistosCommand}" VerticalAlignment="Top"
                                    ToolTipService.ToolTip="marca todos como vistos (apaga o MASTER CAUTION); o historico fica" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="nenhum alerta ainda. O vigia só fala quando faz sentido." Style="{StaticResource CyberBody}" VerticalAlignment="Top"
                                   Visibility="{x:Bind ViewModel.SemAlertas, Mode=OneWay}" />
                        <ListView Grid.Row="1" Margin="-8,0,-8,0" ItemsSource="{x:Bind ViewModel.Alertas}" ItemContainerStyle="{StaticResource SecItemStyle}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SecAlert">
                                    <Grid ColumnSpacing="12" MinHeight="48" Opacity="{x:Bind Opacidade}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="88" CornerRadius="4" Padding="0,3" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Background="{x:Bind Accent, Converter={StaticResource AccentGlow}}"
                                                BorderBrush="{x:Bind Accent, Converter={StaticResource AccentBrush}}">
                                            <TextBlock Text="{x:Bind SevTexto}" Style="{StaticResource CyberLabel}" HorizontalAlignment="Center" Foreground="{x:Bind Accent, Converter={StaticResource AccentBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,6">
                                            <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detalhe}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind QuandoTexto}" Style="{StaticResource CyberCaption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Ver achados" Style="{StaticResource ArcadeButtonSmall}" Tag="{x:Bind}" Click="AlertaVer_Click" Visibility="{x:Bind TemAchado}"
                                                    ToolTipService.ToolTip="abre ACHADOS ja filtrado por esta origem" />
                                            <Button Content="Visto" Style="{StaticResource ArcadeButtonSmall}" Tag="{x:Bind}" Click="AlertaVisto_Click" Visibility="{x:Bind PodeVisto}" />
                                            <Button Style="{StaticResource GhostButton}" ToolTipService.ToolTip="silenciar este alerta por 24 h" AutomationProperties.Name="silenciar por 24 horas" Tag="{x:Bind}" Click="AlertaSilenciar_Click">
                                                <FontIcon Glyph="&#xE74F;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CyberCard}">
                    <ScrollViewer>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Seu normal agora" Style="{StaticResource CyberHeading}" />
                            <TextBlock Text="{x:Bind ViewModel.VigiaBase, Mode=OneWay}" Style="{StaticResource CyberData}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="Só CRÍTICO incomoda (aviso do Windows, barra de tarefas pisca, bipe). ATENÇÃO só aparece como aviso no topo. Nada é bloqueado ou desligado sozinho." Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                            <Button Content="Testar alerta" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.TestarAlertaCommand}"
                                    ToolTipService.ToolTip="levanta um alerta critico de mentira pra ver o aviso, a barra piscar e ouvir o bipe" />
                            <Expander Header="Como funciona" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource CyberCaption}" TextWrapping="Wrap"
                                               Text="A cada 5 s: rede, conexões, destinos novos, processos nascendo (e de onde). A cada 1 min: compara com o SEU normal daquela hora do dia. A cada 5 min: lê o Windows e compara com a leitura anterior." />
                                    <TextBlock Text="Avisa quando" Style="{StaticResource CyberLabel}" />
                                    <TextBlock Style="{StaticResource CyberCaption}" TextWrapping="Wrap"
                                               Text="• upload alto por 3 min seguidos (piso 1,5 MB/s e muito acima do normal)&#x0a;• conexões ou destinos novos disparam&#x0a;• o mesmo programa nasce em loop&#x0a;• programa raro de ataque abre (mshta, certutil…)&#x0a;• programa abre de Temp/Public/Downloads&#x0a;• porta nova escutando · item novo que inicia sozinho&#x0a;• ameaça ou bloqueio novo do Defender, ou o mesmo evento 3x/hora&#x0a;• uma proteção que estava ligada DESLIGOU" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ 4 · HARDENING: 8 = falhas altas; 4 = nota + ASR + auditar ============ -->
            <Grid ColumnSpacing="{StaticResource TileGap}" Visibility="{x:Bind ViewModel.Aba4, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCard}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Falhas altas (HardeningKitty)" Style="{StaticResource CyberHeading}" />
                            <TextBlock Text="{x:Bind ViewModel.AltosResumo, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Altos}" ItemContainerStyle="{StaticResource SecItemStyle}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SecHardeningRow">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detalhe}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="{StaticResource TileGap}">
                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Nota CIS" Style="{StaticResource CyberHeading}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.Score, Mode=OneWay}" Style="{StaticResource CyberDisplay}"
                                               Foreground="{x:Bind ViewModel.ScoreAccent, Mode=OneWay, Converter={StaticResource AccentBrush}}" />
                                    <TextBlock Text="/ 6" Style="{StaticResource CyberBody}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </StackPanel>
                                <ProgressBar Value="{x:Bind ViewModel.ScorePct, Mode=OneWay}" Maximum="100" Style="{StaticResource CyberProgressBar}" />
                                <TextBlock Text="{x:Bind ViewModel.ScoreLegenda, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                                <helpers:GuardedSwitch x:Name="Auditar" Texto="AUDITAR" HorizontalAlignment="Left" Width="130"
                                                       Dica="levante a tampa e aperte: HardeningKitty modo Audit (CIS), so le. Pede admin (UAC), ~3 min. Relatorio em .factory\factory\hardening" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Regras ASR" Style="{StaticResource CyberHeading}" />
                                <TextBlock Text="o que o Defender bloqueia por você" Style="{StaticResource CyberCaption}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AsrRegras}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:SecHardeningRow">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detalhe}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 5 · SQUAD: 8 = parecer; 4 = quem sao e como convocar ============ -->
            <Grid ColumnSpacing="{StaticResource TileGap}" Visibility="{x:Bind ViewModel.Aba5, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyberCard}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Parecer do squad" Style="{StaticResource CyberHeading}" />
                            <TextBlock Text="{x:Bind ViewModel.SquadStatus, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1">
                            <TextBlock helpers:MarkdownLite.Text="{x:Bind ViewModel.SquadTexto, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxWidth="900" HorizontalAlignment="Left" />
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CyberCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Squad de segurança" Style="{StaticResource CyberHeading}" />
                        <TextBlock Text="5 especialistas em 1 consulta ao Claude: Chefe · Triagem · Caça-ameaça · Hardening · Advogado do diabo. Eles só opinam; quem aperta o botão é você." Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Convocar" Style="{StaticResource ArcadeButtonGo}" Command="{x:Bind ViewModel.ConvocarSquadCommand}"
                                    IsEnabled="{x:Bind ViewModel.SquadRodando, Mode=OneWay, Converter={StaticResource Not}}"
                                    ToolTipService.ToolTip="1 consulta ao Claude (gasta assinatura, ~30-60 s) com o retrato de agora. Nada é alterado." />
                            <ProgressRing IsActive="{x:Bind ViewModel.SquadRodando, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="18" Height="18" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
