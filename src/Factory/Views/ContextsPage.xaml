<Page
    x:Class="Factory.Views.ContextsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:helpers="using:Factory.Helpers">

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Text="// CONTEXTOS" Style="{StaticResource CyberTitle}" />

            <Border Style="{StaticResource CyberCardAccent}">
                <StackPanel Spacing="10">
                    <TextBlock Text="JUNTAR CONTEXTOS" Style="{StaticResource CyberHeading}" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                    <TextBlock Text="Um .md so com o STATUS de todos os projetos — pra colar numa sessao nova ou ler de manha." Style="{StaticResource CyberCaption}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="⧉ JUNTAR TUDO" Style="{StaticResource ArcadeButtonGo}"
                                Command="{x:Bind ViewModel.BundleCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Not}}" />
                        <Button Content="ABRIR PASTA" Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonAmber}" IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Bundles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BundleInfo">
                                <Button Content="{x:Bind Name}" Style="{StaticResource ArcadeButton}" Padding="8,3" FontSize="11" Command="{x:Bind OpenCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="PROXIMA ACAO POR PROJETO" Style="{StaticResource CyberHeading}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectInfo">
                        <Border Style="{StaticResource CyberCard}" Padding="16" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CyberBody}">
                                        <Run Text="{x:Bind Name}" Foreground="{StaticResource NeonCyan}" FontWeight="SemiBold" />
                                        <Run Text=" · " Foreground="{StaticResource CyberDim}" />
                                        <Run Text="{x:Bind StatusUpdated, Mode=OneWay}" Foreground="{StaticResource CyberDim}" />
                                        <Run Text=" · " Foreground="{StaticResource CyberDim}" />
                                        <Run Text="{x:Bind LastTouchText, Mode=OneWay}" Foreground="{StaticResource CyberDim}" />
                                    </TextBlock>
                                    <TextBlock helpers:MarkdownLite.Text="{x:Bind NextAction, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" Visibility="{x:Bind HasNextAction, Mode=OneWay}" />
                                    <TextBlock Text="(STATUS sem secao 'Proxima acao' reconhecivel)" Style="{StaticResource CyberCaption}" Visibility="{x:Bind HasNextAction, Mode=OneWay, Converter={StaticResource Not}}" />
                                    <Grid ColumnSpacing="4" Visibility="{x:Bind HasBlockers, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="bloqueio:" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonMagenta}" />
                                        <TextBlock Grid.Column="1" helpers:MarkdownLite.Text="{x:Bind Blockers, Mode=OneWay}" Style="{StaticResource CyberCaption}"
                                                   Foreground="{StaticResource NeonMagenta}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="1" Content="▶ CLAUDE" Style="{StaticResource ArcadeButtonGo}" Padding="10,4" FontSize="11"
                                        Tag="{x:Bind}" Click="OpenClaude_Click" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
