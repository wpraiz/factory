<Page
    x:Class="Factory.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:helpers="using:Factory.Helpers">

    <Page.Resources>
        <!-- chip de filtro: parece o ChipButton da BUSCA; marcado = aresta + texto ciano (cor vem do ViewModel, sai do tema) -->
        <Style x:Key="FiltroButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <ItemsPanelTemplate x:Key="Wrap">
            <helpers:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="FiltroTemplate" x:DataType="models:SetupFiltro">
            <Button Content="{x:Bind Texto, Mode=OneWay}" Style="{StaticResource FiltroButton}"
                    BorderBrush="{x:Bind Borda, Mode=OneWay}" Foreground="{x:Bind Frente, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}" Tag="{x:Bind}" Click="Filtro_Click" />
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate" x:DataType="models:SetupItem">
            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- selo: emoji e o sinal , nao texto colorido -->
                <TextBlock Text="{x:Bind Selo, Mode=OneWay}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Opacity="{x:Bind RowOpacity}">
                    <TextBlock Text="{x:Bind Nome}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <!-- tipo curto em rotulo; origem (se le) em caption — ui-review: origem longa em CyberLabel 10px ficava ilegivel -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TipoRotulo}" Style="{StaticResource CyberLabel}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind OrigemTexto}" Style="{StaticResource CyberCaption}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind OrigemTexto}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Descricao}" Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Visibility="{x:Bind TemDescricao}" ToolTipService.ToolTip="{x:Bind Descricao}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="{x:Bind RowOpacity}">
                    <TextBlock Text="{x:Bind UsoTexto}" Style="{StaticResource CyberBody}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind UsoDetalhe}" Style="{StaticResource CyberCaption}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Tag="{x:Bind}" Click="Joia_Click"
                            ToolTipService.ToolTip="{x:Bind JoiaTooltip, Mode=OneWay}">
                        <TextBlock Text="💎" FontSize="14" Opacity="{x:Bind JoiaOpacity, Mode=OneWay}" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Tag="{x:Bind Caminho}" Click="Pasta_Click"
                            IsEnabled="{x:Bind TemCaminho}" ToolTipService.ToolTip="{x:Bind Caminho}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MaoTemplate" x:DataType="models:MaoOdin">
            <Border Style="{StaticResource CyberChip}" MinWidth="180">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Nome}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Tags}" Style="{StaticResource CyberLabel}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScriptTemplate" x:DataType="models:ScriptFactory">
            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Nome}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Resumo}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EscritaTemplate" x:DataType="models:EscritaFactory">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Onde}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind Oque}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- cabecalho: titulo + resumo; acao da secao (ATUALIZAR) a direita -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="// SETUP" Style="{StaticResource CyberTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Resumo, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.Ocupado, Mode=OneWay}"
                              Foreground="{StaticResource NeonCyan}" Width="18" Height="18" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="ATUALIZAR" Style="{StaticResource ArcadeButtonSmall}"
                        Command="{x:Bind ViewModel.AtualizarCommand}" VerticalAlignment="Center"
                        ToolTipService.ToolTip="relê ~/.claude e só as sessões novas ou alteradas (não gasta nada)" />
            </Grid>
            <TextBlock Text="tudo que o Claude Code carrega — skills, agentes, plugins, MCP e hooks — de onde vem e quanto foi usado de verdade"
                       Style="{StaticResource CyberBody}" Foreground="{StaticResource CyberDim}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CyberCaption}" />

            <!-- abas: texto kicker + traco ciano embaixo da ativa (ui/ux-review: pilula igual aos chips de filtro
                 misturava "em que aba estou" com "o que estou filtrando") -->
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource GhostButton}" Padding="0,4" CornerRadius="0" Command="{x:Bind ViewModel.VerSetupCommand}"
                        ToolTipService.ToolTip="skills, agentes, plugins, MCP e hooks com uso real">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CLAUDE CODE" Style="{StaticResource CyberKicker}" Foreground="{x:Bind ViewModel.SetupAbaFrente, Mode=OneWay}" />
                        <Rectangle Height="2" Fill="{x:Bind ViewModel.SetupAbaBorda, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0,4" CornerRadius="0" Command="{x:Bind ViewModel.VerMapaCommand}"
                        ToolTipService.ToolTip="mãos do Odin, scripts de tools\ e onde o app escreve">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MAPA DO FACTORY" Style="{StaticResource CyberKicker}" Foreground="{x:Bind ViewModel.MapaAbaFrente, Mode=OneWay}" />
                        <Rectangle Height="2" Fill="{x:Bind ViewModel.MapaAbaBorda, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===================== CLAUDE CODE ===================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.MostraSetup, Mode=OneWay}">

                <!-- duas fileiras de filtro com rotulo de canto: TIPO e SELO se combinam (E) -->
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TIPO" Style="{StaticResource CyberLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Tipos}" ItemTemplate="{StaticResource FiltroTemplate}" ItemsPanel="{StaticResource Wrap}" />
                    <TextBlock Grid.Row="1" Text="SELO" Style="{StaticResource CyberLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Selos}" ItemTemplate="{StaticResource FiltroTemplate}" ItemsPanel="{StaticResource Wrap}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BuscaBox" PlaceholderText="buscar por nome, descrição ou origem…" FontFamily="{StaticResource MonoFont}"
                             Text="{x:Bind ViewModel.Busca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource CyberCombo}" MinWidth="160"
                              ItemsSource="{x:Bind ViewModel.Ordens}" SelectedItem="{x:Bind ViewModel.Ordem, Mode=TwoWay}"
                              ToolTipService.ToolTip="ordenar" />
                </Grid>

                <!-- nota de retencao: sem ela "0 usos" parece verdade absoluta. Card neutro (ui-review): ambar fica pra aviso acionavel -->
                <Border Style="{StaticResource CyberCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource CyberDim}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Nota, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ClaudeMd, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CyberCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ListaTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                        <TextBlock Text="nada com esse filtro — limpe a busca ou volte pra TUDO / TODOS" Style="{StaticResource CyberCaption}" Margin="0,8"
                                   Visibility="{x:Bind ViewModel.SemItens, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Itens}" ItemTemplate="{StaticResource ItemTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== MAPA DO FACTORY ===================== -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.MostraMapa, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.MaosTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                    <TextBlock Text="lidas de Assets\hands.json · tags: leitura, escrita, executa, mouse, rede, gasta"
                               Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Maos}" ItemTemplate="{StaticResource MaoTemplate}" ItemsPanel="{StaticResource Wrap}" />
                </StackPanel>

                <Border Style="{StaticResource CyberCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ScriptsTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scripts}" ItemTemplate="{StaticResource ScriptTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ONDE O APP ESCREVE" Style="{StaticResource CyberKicker}" />
                        <TextBlock Text="espelho da regra do CLAUDE.md — fora daqui o Factory só lê" Style="{StaticResource CyberCaption}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Escritas}" ItemTemplate="{StaticResource EscritaTemplate}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
