<Page
    x:Class="Factory.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:helpers="using:Factory.Helpers">

    <Page.Resources>
        <!-- chip de filtro: o mesmo FiltroButton do SETUP (marcado = aresta + texto ciano, cor vem do SetupFiltro) -->
        <Style x:Key="FiltroButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- RUIM/DEPOIS: fantasma com texto (ui-review: 3 botoes ciano por card x ~80 cards virava parede de neon;
             BOM e o unico acento do card). Tipografia igual a do ArcadeButtonSmall (11/Bold/150). -->
        <Style x:Key="DecisaoGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="150" />
            <Setter Property="Foreground" Value="{StaticResource CyberText}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- selo da fonte: rotulo de canto numa aresta de 1 px, sem cor de acento (a cor do card fica pro estado) -->
        <Style x:Key="SeloBorda" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <ItemsPanelTemplate x:Key="Wrap">
            <helpers:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="Pilha">
            <StackPanel Spacing="12" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="FiltroTemplate" x:DataType="models:SetupFiltro">
            <Button Content="{x:Bind Texto, Mode=OneWay}" Style="{StaticResource FiltroButton}"
                    BorderBrush="{x:Bind Borda, Mode=OneWay}" Foreground="{x:Bind Frente, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}" Tag="{x:Bind}" Click="Filtro_Click" />
        </DataTemplate>

        <!-- ===== RUMO: tile so de leitura (norte, placar, feito, etapas; nao e decisao, e o mapa) ===== -->
        <DataTemplate x:Key="RumoTemplate" x:DataType="models:BoardCard">
            <Border Style="{StaticResource AppTile}" Width="484" MinHeight="0" Padding="20"
                    PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberTileHeading}" TextWrapping="Wrap" MaxLines="2" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="6" Tag="{x:Bind}" Click="Fonte_Click"
                                VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind FonteTooltip}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        </Button>
                    </Grid>
                    <TextBlock helpers:MarkdownLite.Text="{x:Bind Resumo}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap"
                               MaxLines="20" IsTextSelectionEnabled="True" Visibility="{x:Bind TemResumo}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== DECIDA AGORA: tile de decisao — titulo e resumo curtos,
             nota escondida atras de "+ nota", BOM e o unico acento; hover com mola; o card sai animado ao decidir ===== -->
        <DataTemplate x:Key="CardTemplate" x:DataType="models:BoardCard">
            <Border Style="{StaticResource AppTile}" Width="484" MinHeight="0" Padding="20"
                    PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SeloBorda}">
                            <TextBlock Text="{x:Bind Selo}" Style="{StaticResource CyberLabel}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Secao}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Secao}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6" Tag="{x:Bind}" Click="Fonte_Click"
                                ToolTipService.ToolTip="{x:Bind FonteTooltip}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberTileHeading}" TextWrapping="Wrap"
                               MaxLines="3" IsTextSelectionEnabled="True" />
                    <TextBlock helpers:MarkdownLite.Text="{x:Bind Resumo}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap"
                               MaxLines="4" IsTextSelectionEnabled="True" Visibility="{x:Bind TemResumo}" />

                    <TextBox Text="{x:Bind Nota, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             PlaceholderText="nota curta — vai junto da decisão" MaxLength="280"
                             Tag="{x:Bind}" KeyDown="Nota_KeyDown" Visibility="{x:Bind NotaAberta, Mode=OneWay}"
                             ToolTipService.ToolTip="Ctrl+Enter grava como BOM" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="+ nota" Style="{StaticResource GhostButton}" Padding="0,4" HorizontalAlignment="Left"
                                Foreground="{StaticResource CyberDim}" Tag="{x:Bind}" Click="NotaToggle_Click"
                                ToolTipService.ToolTip="escrever um porquê junto da decisão (opcional)" />
                        <Button Grid.Column="1" Content="BOM" Style="{StaticResource ArcadeButtonSmall}" Tag="{x:Bind}" Click="Bom_Click"
                                ToolTipService.ToolTip="aprovo — grava em .factory\factory\decisoes.jsonl e o card sai da lista" />
                        <Button Grid.Column="2" Content="RUIM" Style="{StaticResource DecisaoGhost}" Tag="{x:Bind}" Click="Ruim_Click"
                                ToolTipService.ToolTip="não quero — grava a decisão; a fonte não é alterada" />
                        <Button Grid.Column="3" Content="DEPOIS" Style="{StaticResource DecisaoGhost}" Tag="{x:Bind}" Click="Depois_Click"
                                ToolTipService.ToolTip="agora não — sai da lista; dá pra mudar em DECIDIDO" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- entrada em cascata + saida/reposicao animadas: o card decidido sai e os outros deslizam pro lugar -->
        <TransitionCollection x:Key="Fluido">
            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="14" />
            <AddDeleteThemeTransition />
            <RepositionThemeTransition />
        </TransitionCollection>

        <ItemsPanelTemplate x:Key="Tiles">
            <helpers:WrapPanel HorizontalSpacing="16" VerticalSpacing="16" />
        </ItemsPanelTemplate>
        <!-- ===== linha DECIDIDO: compacta, mostra a decisao; os 3 botoes mudam (nova linha no jsonl) ===== -->
        <DataTemplate x:Key="DecididoTemplate" x:DataType="models:BoardCard">
            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DecisaoRotulo, Mode=OneWay}" Style="{StaticResource CyberLabel}"
                           Foreground="{StaticResource CyberTextBright}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Titulo}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               ToolTipService.ToolTip="{x:Bind Titulo}" />
                    <TextBlock Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis" MaxLines="1">
                        <Run Text="{x:Bind Selo}" /><Run Text=" · " /><Run Text="{x:Bind DecisaoDetalhe, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="BOM" Style="{StaticResource DecisaoGhost}" Padding="8,2" Tag="{x:Bind}" Click="Bom_Click" ToolTipService.ToolTip="mudar pra BOM" />
                    <Button Content="RUIM" Style="{StaticResource DecisaoGhost}" Padding="8,2" Tag="{x:Bind}" Click="Ruim_Click" ToolTipService.ToolTip="mudar pra RUIM" />
                    <Button Content="DEPOIS" Style="{StaticResource DecisaoGhost}" Padding="8,2" Tag="{x:Bind}" Click="Depois_Click" ToolTipService.ToolTip="mudar pra DEPOIS" />
                    <Button Style="{StaticResource GhostButton}" Tag="{x:Bind}" Click="Fonte_Click" ToolTipService.ToolTip="{x:Bind FonteTooltip}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- cabecalho FIXO (titulo, status, filtro) e so as listas rolam: com ~80 cards a confirmacao
         "gravado" no topo sumia da tela quando ele decidia la embaixo (ux-review ALTO) -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- cabecalho: titulo + contador; acao da secao (ATUALIZAR) a direita -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="// PLANO" Style="{StaticResource CyberTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Resumo, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.Ocupado, Mode=OneWay}"
                              Foreground="{StaticResource NeonCyan}" Width="18" Height="18" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="ATUALIZAR" Style="{StaticResource ArcadeButtonSmall}"
                        Command="{x:Bind ViewModel.AtualizarCommand}" VerticalAlignment="Center"
                        ToolTipService.ToolTip="relê STATUS, planos e decisoes.jsonl (não gasta nada)" />
            </Grid>
            <TextBlock Text="em cima, só o que precisa de você agora; embaixo, o RUMO (o mapa). O resto arquiva de uma vez — as fontes nunca são editadas"
                       Style="{StaticResource CyberBody}" Foreground="{StaticResource CyberDim}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />

            <!-- fonte ausente/ilegivel: a tela diz o que faltou (regra: nao inventar estado) -->
            <Border Style="{StaticResource CyberCardWarn}" Visibility="{x:Bind ViewModel.TemFaltas, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource NeonAmber}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Faltas, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FONTE" Style="{StaticResource CyberLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Fontes}" ItemTemplate="{StaticResource FiltroTemplate}" ItemsPanel="{StaticResource Wrap}" />
            </Grid>

        </StackPanel>

        <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,16,0">
            <!-- ===================== A DECIDIR ===================== -->
            <!-- o resto numa faixa so (107 cards to approve was a wall): ARQUIVAR grava DEPOIS em lote; VER TODOS abre -->
            <Border Style="{StaticResource CyberCard}" Padding="16,12" Visibility="{x:Bind ViewModel.TemResto, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.RestoTexto, Mode=OneWay}" Style="{StaticResource CyberBody}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="ARQUIVAR COMO DEPOIS" Style="{StaticResource ArcadeButtonSmall}"
                            Command="{x:Bind ViewModel.ArquivarRestoCommand}" VerticalAlignment="Center"
                            ToolTipService.ToolTip="grava DEPOIS em todos de baixo de uma vez; ficam em DECIDIDO e dá pra mudar um por um" />
                    <Button Grid.Column="2" Content="{x:Bind ViewModel.VerTodosRotulo, Mode=OneWay}" Style="{StaticResource DecisaoGhost}"
                            Command="{x:Bind ViewModel.AlternarVerTodosCommand}" VerticalAlignment="Center"
                            ToolTipService.ToolTip="mostra todos os itens em aberto, ou volta pros 5 de cima" />
                </Grid>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.ADecidirTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" />
            <TextBlock Text="nada a decidir nesta fonte — o que já foi decidido está em DECIDIDO, logo abaixo"
                       Style="{StaticResource CyberCaption}" Visibility="{x:Bind ViewModel.SemADecidir, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.ADecidir}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource Tiles}"
                          ItemContainerTransitions="{StaticResource Fluido}" />

            <!-- ===================== RUMO (mapa, so leitura) ===================== -->
            <TextBlock Text="RUMO" Style="{StaticResource CyberKicker}" Margin="0,16,0,0" Visibility="{x:Bind ViewModel.TemRumo, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rumo}" ItemTemplate="{StaticResource RumoTemplate}" ItemsPanel="{StaticResource Tiles}"
                          ItemContainerTransitions="{StaticResource Fluido}" Visibility="{x:Bind ViewModel.TemRumo, Mode=OneWay}" />




            <!-- ===================== DECIDIDO (recolhido, igual ao ANTES da FROTA) ===================== -->
            <StackPanel Spacing="4" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.TemDecididos, Mode=OneWay}">
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.AlternarDecididosCommand}" Padding="0,4"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="mostrar/esconder o que já foi decidido (dá pra mudar a decisão)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DecididosTitulo, Mode=OneWay}" Style="{StaticResource CyberKicker}" VerticalAlignment="Center" />
                        <FontIcon Glyph="{x:Bind ViewModel.DecididosChevron, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Decididos}" ItemTemplate="{StaticResource DecididoTemplate}"
                              Visibility="{x:Bind ViewModel.DecididosAberto, Mode=OneWay}" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
