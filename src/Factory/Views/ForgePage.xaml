<Page
    x:Class="Factory.Views.ForgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20">
        <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="// FABRICA" Style="{StaticResource CyberTitle}" />

            <Border Style="{StaticResource CyberCardAccent}">
                <StackPanel Spacing="12">
                    <TextBlock Text="FORJAR PROJETO NOVO" Style="{StaticResource CyberHeading}" />
                    <TextBlock Style="{StaticResource CyberCaption}" TextWrapping="Wrap">
                        <Run Text="Cria " /><Run Text="{x:Bind ViewModel.RootText}" Foreground="{StaticResource NeonCyan}" /><Run Text="\&lt;nome&gt; ja com o contrato que o cockpit le: README, CLAUDE.md, STATUS.md canonico e factory.json." />
                    </TextBlock>

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="nome da pasta (minusculas, ex.: meu-projeto)" FontFamily="{StaticResource MonoFont}"
                                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1" Header="tipo" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                  ItemsSource="{x:Bind ViewModel.Kinds}" SelectedItem="{x:Bind ViewModel.Kind, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="o que e (uma ou duas frases — vai pro README, CLAUDE.md e STATUS)" FontFamily="{StaticResource MonoFont}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                 Text="{x:Bind ViewModel.Description, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <CheckBox Content="git init" FontFamily="{StaticResource MonoFont}" IsChecked="{x:Bind ViewModel.GitInit, Mode=TwoWay}" />
                        <CheckBox Content="abrir Claude na pasta depois" FontFamily="{StaticResource MonoFont}" IsChecked="{x:Bind ViewModel.OpenAfter, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="⚒ FORJAR" Style="{StaticResource ArcadeButtonGo}"
                                Command="{x:Bind ViewModel.ForgeCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Not}}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="20" Height="20" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.Log, Mode=OneWay}" Style="{StaticResource CyberCaption}" Foreground="{StaticResource NeonAmber}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CyberCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ROADMAP" Style="{StaticResource CyberHeading}" />
                    <TextBlock Style="{StaticResource CyberBody}" TextWrapping="Wrap">
                        <Run Text="FASE 1 — COCKPIT" Foreground="{StaticResource NeonGreen}" /><LineBreak />
                        <Run Text="inventario da raiz de projetos, STATUS + sessoes do Claude por projeto, retomar em 1 clique, juntar contextos, manifesto por projeto, forjar projeto novo." /><LineBreak /><LineBreak />
                        <Run Text="FASE 2 — LINHAS DE PRODUCAO" Foreground="{StaticResource CyberDim}" /><LineBreak />
                        <Run Text="templates reais por tipo (infoproduto c/ gerador, site WP p/ cliente, plugin, conteudo) e pipeline ideia → build → publicar, com o portao irreversivel sempre na mao do dono." /><LineBreak /><LineBreak />
                        <Run Text="FASE 3 — GRANA VIVA" Foreground="{StaticResource CyberDim}" /><LineBreak />
                        <Run Text="ligar fontes reais (Hotmart, AdSense, GA4) ao painel de Grana em vez do texto declarado no manifesto." />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
