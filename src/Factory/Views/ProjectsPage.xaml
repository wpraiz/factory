<Page
    x:Class="Factory.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models"
    xmlns:helpers="using:Factory.Helpers">

    <Page.Resources>
        <CollectionViewSource x:Name="ProjectsCvs" IsSourceGrouped="True" ItemsPath="Items" />

        <!-- Card do canvas: mesmo painel do tema, um pouco mais denso. Regra da forja: UM acento por card
             (no titulo); o resto do texto e CyberText/CyberDim, estado vem de LED ou rotulo curto. -->
        <Style x:Key="NodeCard" TargetType="Border" BasedOn="{StaticResource CyberCard}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Width" Value="640" />
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource ArcadeButtonSmall}">
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <!-- chip de tag / arquivo: parece link, age como botao. Texto calmo; a cor de acento fica pro hover do sistema.
             Padding 8,2 e 2,1 de proposito (fora da escala): sao chips/links minusculos dentro de linha de texto. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource CyberText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CyberPanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- link de arquivo: 12 = CyberConsole (e um Button, por isso o FontSize fica aqui) -->
        <Style x:Key="FileLink" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource CyberText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="ChipRow" x:DataType="models:Chip">
            <Button Content="{x:Bind Text}" Style="{StaticResource ChipButton}" Command="{x:Bind Command}" Margin="0,0,4,4" ToolTipService.ToolTip="{x:Bind Tooltip}" />
        </DataTemplate>
        <DataTemplate x:Key="FileRow" x:DataType="models:Chip">
            <Button Content="{x:Bind Label}" Style="{StaticResource FileLink}" Command="{x:Bind Command}" ToolTipService.ToolTip="{x:Bind Tooltip}" />
        </DataTemplate>
        <DataTemplate x:Key="SessionRow" x:DataType="models:SessionInfo">
            <Grid Padding="0,8" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- LED: verde = arquivo mexido ha < 2 min (sessao aberta agora) -->
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,2,0"
                         Fill="{x:Bind IsLive, Mode=OneWay, Converter={StaticResource StatusBrush}}"
                         Opacity="{x:Bind IsLive, Mode=OneWay, Converter={StaticResource LiveOpacity}}"
                         ToolTipService.ToolTip="verde = sessao ativa agora" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CyberMicro}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- frescor como rotulo curto: verde = vivo, cinza = parado, ambar = arquivos mudaram depois da sessao -->
                        <TextBlock Text="{x:Bind Freshness}" Style="{StaticResource CyberLabel}" Foreground="{StaticResource NeonGreen}" Visibility="{x:Bind IsFresh}" />
                        <TextBlock Text="{x:Bind Freshness}" Style="{StaticResource CyberLabel}" Visibility="{x:Bind IsStale}" />
                        <TextBlock Text="{x:Bind Freshness}" Style="{StaticResource CyberLabel}" Foreground="{StaticResource NeonAmber}" Visibility="{x:Bind IsDrifted}" />
                        <ToggleButton Content="{x:Bind EditedText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="6,0" MinHeight="0"
                                      Background="Transparent" BorderThickness="0" Foreground="{StaticResource CyberDim}"
                                      IsChecked="{x:Bind ShowEdited, Mode=TwoWay}" Visibility="{x:Bind HasEdited}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Edited}" ItemTemplate="{StaticResource FileRow}" Visibility="{x:Bind ShowEdited, Mode=OneWay}" Margin="8,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="◈" Style="{StaticResource TinyButton}" Command="{x:Bind BriefCommand}" ToolTipService.ToolTip="briefing de retomada (claude -p)" />
                    <Button Content="↗" Style="{StaticResource TinyButton}" Command="{x:Bind GoCommand}" Visibility="{x:Bind HasGo}" ToolTipService.ToolTip="ir pro projeto da sessao" />
                </StackPanel>
                <Button Grid.Column="3" Content="▶" Style="{StaticResource TinyButton}" Command="{x:Bind ResumeCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="claude --resume" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MentionRow" x:DataType="models:MentionHit">
            <Grid Padding="0,8" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource CyberBody}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Name}" /><Run Text="  " /><Run Text="{x:Bind Meta}" Foreground="{StaticResource CyberDim}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind Snippet}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="↗" Style="{StaticResource TinyButton}" Command="{x:Bind GoCommand}" Visibility="{x:Bind HasGo}" VerticalAlignment="Center" ToolTipService.ToolTip="ir pro projeto do arquivo" />
                <Button Grid.Column="2" Content="ABRIR" Style="{StaticResource TinyButton}" Command="{x:Bind OpenCommand}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <SplitView
        IsPaneOpen="{x:Bind ViewModel.IsListOpen, Mode=TwoWay}"
        DisplayMode="Inline"
        OpenPaneLength="360"
        PaneBackground="Transparent">

        <!-- ===== Pane: lista de projetos ===== -->
        <SplitView.Pane>
            <Grid Padding="16,20,8,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="// PROJETOS" Style="{StaticResource CyberTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="filtrar… (#tag filtra por tag)" FontFamily="{StaticResource MonoFont}"
                             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- varrendo: o anel aparece ao lado da acao que disparou -->
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                  Foreground="{StaticResource NeonCyan}" Width="18" Height="18" VerticalAlignment="Center" />
                    <!-- rescan e secundario: fantasma, icone-so, como o recarregar da VIDA -->
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.RescanCommand}"
                            IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource Not}}" ToolTipService.ToolTip="reler a raiz de projetos">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- nuvem de tags: GridView so pelo wrap; nada de selecao -->
                <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.TagCloud}" ItemTemplate="{StaticResource ChipRow}"
                          SelectionMode="None" IsItemClickEnabled="False" MaxHeight="96" Padding="0" Margin="0,-4,0,0">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <Border Grid.Row="3" Style="{StaticResource CyberCard}" Padding="4">
                    <ListView ItemsSource="{x:Bind ProjectsCvs.View}"
                              SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:ProjectGroup">
                                        <TextBlock Text="{x:Bind HeaderText}" Style="{StaticResource CyberLabel}" Foreground="{StaticResource NeonCyan}" Margin="4,8,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectInfo">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CyberBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <!-- fixado: o unico detalhe em ambar da lista -->
                                            <TextBlock Text="★" Style="{StaticResource CyberBody}" Foreground="{StaticResource NeonAmber}" Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Badges, Mode=OneWay}" Style="{StaticResource CyberMicro}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TagsText, Mode=OneWay}" Style="{StaticResource CyberMicro}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasTags, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind LastTouchText, Mode=OneWay}" Style="{StaticResource CyberMicro}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </SplitView.Pane>

        <!-- ===== Conteudo: canvas ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- barra do canvas -->
            <Grid Padding="12,20,16,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.ToggleListCommand}" ToolTipService.ToolTip="mostrar/esconder lista">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.GoBackCommand}" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" ToolTipService.ToolTip="projeto anterior">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.GoForwardCommand}" IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}" ToolTipService.ToolTip="projeto seguinte">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="3" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" />
                    <Run Text="  " /><Run Text="{x:Bind ViewModel.TrailStatus, Mode=OneWay}" />
                    <Run Text="  " /><Run Text="{x:Bind ViewModel.Message, Mode=OneWay}" Foreground="{StaticResource CyberText}" />
                </TextBlock>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="AJUSTAR" Style="{StaticResource ArcadeButtonSmall}" Click="Fit_Click" ToolTipService.ToolTip="encaixa o canvas inteiro na tela" />
                    <Button Content="1:1" Style="{StaticResource ArcadeButtonSmall}" Click="Reset_Click" ToolTipService.ToolTip="zoom 100%" />
                    <Button Content="REFAZER RASTRO" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.RetrailCommand}" ToolTipService.ToolTip="rele pasta, sessoes e mencoes deste projeto" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="← selecione um projeto  ·  Ctrl+K busca tudo  ·  arraste pra mover, roda do mouse pra zoom"
                       Style="{StaticResource CyberBody}" Foreground="{StaticResource CyberDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.NoSelection, Mode=OneWay}" />

            <ScrollViewer x:Name="Viewport" Grid.Row="1"
                          ZoomMode="Enabled" MinZoomFactor="0.3" MaxZoomFactor="2.5"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Canvas x:Name="Board" Width="2120" Height="2150">
                    <!-- superficie de pan/zoom (fica atras dos cards) -->
                    <Rectangle x:Name="PanSurface" Width="2120" Height="2150" Fill="Transparent"
                               PointerPressed="Pan_Pressed" PointerMoved="Pan_Moved" PointerReleased="Pan_Released"
                               PointerCanceled="Pan_Released" PointerCaptureLost="Pan_Released" PointerWheelChanged="Pan_Wheel" />

                    <!-- fios: centro → cada card (e STATUS → BRIEFING). Uma cor so: sao fios, nao estado.
                         As pontas sao calculadas no code-behind (Rewire) a partir da posicao e altura REAL de cada card,
                         no Loaded e a cada SizeChanged: card que cresce nao desalinha o fio. -->
                    <Line x:Name="WireFolder"   Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireDb"       Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireManifest" Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireOwn"      Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireMentions" Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireDocs"     Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireStatus"   Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireSystem"   Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />
                    <Line x:Name="WireBriefing" Stroke="{StaticResource NeonCyanGlow}" StrokeThickness="1.5" StrokeDashArray="6,4" />

                    <!-- ===== SISTEMA: o que o Windows sabe do projeto. Acento: ambar (no titulo). ===== -->
                    <Border x:Name="CardSystem" Canvas.Left="760" Canvas.Top="40" Style="{StaticResource NodeCard}" Width="600">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="SISTEMA · processos · atalhos · tasks" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonAmber}" />
                            <TextBlock Text="{x:Bind ViewModel.SystemText, Mode=OneWay}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Processes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LiveProcess">
                                        <Grid Padding="0,6" ColumnSpacing="8" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- LED verde: processo rodando agora (e o unico verde do card) -->
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource NeonGreen}" Margin="0,0,2,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource CyberConsole}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="■ MATAR" Style="{StaticResource ArcadeButtonDanger}" FontSize="11" Padding="12,4"
                                                    Tag="{x:Bind}" Click="Kill_Click" VerticalAlignment="Center" ToolTipService.ToolTip="encerra o processo (pede confirmacao)" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Shortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ShortcutHit">
                                        <StackPanel Padding="0,6" Spacing="2" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                            <TextBlock Style="{StaticResource CyberConsole}"><Run Text="atalho " Foreground="{StaticResource CyberDim}" /><Run Text="{x:Bind Name}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskHit">
                                        <StackPanel Padding="0,6" Spacing="2" BorderBrush="{StaticResource CyberPanelEdge}" BorderThickness="0,0,0,1">
                                            <TextBlock Style="{StaticResource CyberConsole}"><Run Text="task " Foreground="{StaticResource CyberDim}" /><Run Text="{x:Bind Text}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Action}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== CENTRO: o projeto. Acento: ciano (titulo + aresta). Unica acao verde do canvas: CLAUDE. ===== -->
                    <Border x:Name="CardCenter" Canvas.Left="760" Canvas.Top="400" Style="{StaticResource CyberCardAccent}" Width="600">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <!-- 17 (CyberHeading), nao 26: o unico CyberTitle da tela e o // PROJETOS do pane -->
                            <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" Style="{StaticResource CyberHeading}" Foreground="{StaticResource NeonCyan}" CharacterSpacing="200" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.Path, Mode=OneWay}" Style="{StaticResource CyberCaption}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.Badges, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.TagsText, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Selected.HasTags, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.PotentialText, Mode=OneWay}" Style="{StaticResource CyberCaption}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Selected.HasPotential, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="▶ CLAUDE" Style="{StaticResource ArcadeButtonGo}" FontSize="11" Padding="12,4" Command="{x:Bind ViewModel.OpenClaudeCommand}" ToolTipService.ToolTip="abre o Claude Code nesta pasta" />
                                <Button Content="TERMINAL" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.OpenTerminalCommand}" />
                                <Button Content="EXPLORER" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.OpenExplorerCommand}" />
                                <Button Content="COPIAR" Style="{StaticResource ArcadeButtonSmall}" Command="{x:Bind ViewModel.CopyPathCommand}" ToolTipService.ToolTip="copia o caminho da pasta" />
                            </StackPanel>
                            <!-- proxima acao: onde a voz sobe (branco), nao neon -->
                            <TextBlock helpers:MarkdownLite.Text="{x:Bind ViewModel.Selected.NextAction, Mode=OneWay}" Style="{StaticResource CyberConsole}" Foreground="{StaticResource CyberTextBright}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ===== PASTA. Acento: ciano. ===== -->
                    <Border x:Name="CardFolder" Canvas.Left="40" Canvas.Top="40" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="PASTA" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" />
                            <TextBlock Text="{x:Bind ViewModel.FolderText, Mode=OneWay}" Style="{StaticResource CyberConsole}" />
                            <TextBlock Text="entradas (clique abre)" Style="{StaticResource CyberMicro}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.EntryPoints}" ItemTemplate="{StaticResource ChipRow}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="recentes (clique abre)" Style="{StaticResource CyberMicro}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentFiles}" ItemTemplate="{StaticResource FileRow}" />
                            <TextBlock Text="{x:Bind ViewModel.GitText, Mode=OneWay}" Style="{StaticResource CyberConsole}" Foreground="{StaticResource CyberDim}" />
                            <TextBlock Text="{x:Bind ViewModel.StackText, Mode=OneWay}" Style="{StaticResource CyberConsole}" Foreground="{StaticResource CyberDim}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasStart, Mode=OneWay}">
                                <Button Content="▶ RODAR" Style="{StaticResource ArcadeButtonGo}" FontSize="11" Padding="12,4" Command="{x:Bind ViewModel.StartCommand}" ToolTipService.ToolTip="abre o terminal na pasta e roda o comando" />
                                <TextBlock Text="{x:Bind ViewModel.StartCmdText, Mode=OneWay}" Style="{StaticResource CyberCaption}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== BANCOS. Acento: ciano. ===== -->
                    <Border x:Name="CardDb" Canvas.Left="40" Canvas.Top="660" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="BANCOS (SQLite, read-only)" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" />
                            <TextBlock Text="{x:Bind ViewModel.DbText, Mode=OneWay}" Style="{StaticResource CyberConsole}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== MANIFESTO. Acento: ciano; SALVAR e a unica acao verde do card. ===== -->
                    <Border x:Name="CardManifest" Canvas.Left="40" Canvas.Top="1000" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="MANIFESTO :: factory.json" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" VerticalAlignment="Center" />
                                <ToggleSwitch HorizontalAlignment="Right" OnContent="fixado" OffContent="fixar" FontFamily="{StaticResource MonoFont}" FontSize="11" MinWidth="0"
                                              IsOn="{x:Bind ViewModel.EditPinned, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="tipo" PlaceholderText="—" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                          ItemsSource="{x:Bind ViewModel.Kinds}" SelectedItem="{x:Bind ViewModel.EditKind, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="estagio" PlaceholderText="—" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                          ItemsSource="{x:Bind ViewModel.Stages}" SelectedItem="{x:Bind ViewModel.EditStage, Mode=TwoWay}" />
                                <ComboBox Grid.Column="2" Header="modelo de grana" PlaceholderText="—" HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                          ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.EditModel, Mode=TwoWay}" />

                                <Slider Grid.Row="1" Header="potencial (0 = n/a)" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.EditPotential, Mode=TwoWay}" />
                                <Slider Grid.Row="1" Grid.Column="1" Header="esforco ate render" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.EditEffort, Mode=TwoWay}" />
                                <Slider Grid.Row="1" Grid.Column="2" Header="confianca (5 = ja vende)" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.EditConfidence, Mode=TwoWay}" />

                                <Slider Grid.Row="2" Header="alcance (1 cliente … 5 SEO)" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.EditReach, Mode=TwoWay}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Header="dias ate o 1º real" FontFamily="{StaticResource MonoFont}" PlaceholderText="0 = nao sei"
                                         Text="{x:Bind ViewModel.EditFirstMoneyDays, Mode=TwoWay}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Header="receita R$/mes (hoje)" FontFamily="{StaticResource MonoFont}" PlaceholderText="0"
                                         Text="{x:Bind ViewModel.EditRevenue, Mode=TwoWay}" />

                                <TextBox Grid.Row="3" Header="meta 90 d (R$/mes)" FontFamily="{StaticResource MonoFont}" PlaceholderText="0"
                                         Text="{x:Bind ViewModel.EditRevenueTarget, Mode=TwoWay}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Header="tags (virgula)" FontFamily="{StaticResource MonoFont}" PlaceholderText="cliente, seo, blog…"
                                         Text="{x:Bind ViewModel.EditTags, Mode=TwoWay}" />

                                <TextBox Grid.Row="4" Grid.ColumnSpan="2" Header="grana (texto livre)" FontFamily="{StaticResource MonoFont}" Text="{x:Bind ViewModel.EditMoney, Mode=TwoWay}" />
                                <TextBox Grid.Row="4" Grid.Column="2" Header="url" FontFamily="{StaticResource MonoFont}" Text="{x:Bind ViewModel.EditUrl, Mode=TwoWay}" />
                                <TextBox Grid.Row="5" Grid.ColumnSpan="3" Header="notas" FontFamily="{StaticResource MonoFont}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                                         Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay}" />
                            </Grid>
                            <Button Content="SALVAR" Style="{StaticResource ArcadeButtonGo}" FontSize="11" Padding="12,4" Command="{x:Bind ViewModel.SaveManifestCommand}" ToolTipService.ToolTip="grava o factory.json do projeto" />
                        </StackPanel>
                    </Border>

                    <!-- ===== SESSOES PROPRIAS. Titulo neutro: o acento do card e o LED verde das sessoes vivas. ===== -->
                    <Border x:Name="CardOwn" Canvas.Left="1440" Canvas.Top="40" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="SESSOES NESTA PASTA" Style="{StaticResource CyberNodeTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.OwnSessionsText, Mode=OneWay}" Style="{StaticResource CyberMicro}" />
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.OwnSessions}" ItemTemplate="{StaticResource SessionRow}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ===== SESSOES QUE CITAM. Idem. ===== -->
                    <Border x:Name="CardMentions" Canvas.Left="1440" Canvas.Top="620" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="SESSOES DE OUTRAS PASTAS QUE CITAM" Style="{StaticResource CyberNodeTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.MentionSessionsText, Mode=OneWay}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MentionSessions}" ItemTemplate="{StaticResource SessionRow}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ===== MENCOES EM ARQUIVOS. Acento: ciano. ===== -->
                    <Border x:Name="CardDocs" Canvas.Left="1440" Canvas.Top="1200" Style="{StaticResource NodeCard}">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="MEMORIA · WIKI · _MYLOOP · OUTROS PROJETOS" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" />
                            <TextBlock Text="{x:Bind ViewModel.DocMentionsText, Mode=OneWay}" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DocMentions}" ItemTemplate="{StaticResource MentionRow}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ===== BRIEFING (claude -p). Acento: ciano; GRAVAR e a unica acao verde do card. ===== -->
                    <Border x:Name="CardBriefing" Canvas.Left="760" Canvas.Top="1620" Style="{StaticResource NodeCard}" Width="600">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="BRIEFING DE RETOMADA" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" />
                            <TextBlock Text="clique ◈ numa sessao: o Claude (headless, sem tools) resume onde parou, proxima acao e bloqueios" Style="{StaticResource CyberMicro}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BriefingTitle, Mode=OneWay}" Style="{StaticResource CyberConsole}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBriefing, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBriefing, Mode=OneWay}" Foreground="{StaticResource NeonCyan}" Width="18" Height="18" />
                                <TextBlock Text="{x:Bind ViewModel.BriefingStatus, Mode=OneWay}" Style="{StaticResource CyberMicro}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.BriefingText, Mode=OneWay}" Style="{StaticResource CyberConsole}" />
                            <Button Content="GRAVAR COMO STATUS.md" Style="{StaticResource ArcadeButtonGo}" FontSize="11" Padding="12,4"
                                    Visibility="{x:Bind ViewModel.HasBriefing, Mode=OneWay}" Click="SaveStatus_Click"
                                    ToolTipService.ToolTip="abre um preview editavel; se ja existe STATUS.md, faz backup .bak antes" />
                        </StackPanel>
                    </Border>

                    <!-- ===== STATUS. Acento: ciano. ===== -->
                    <Border x:Name="CardStatus" Canvas.Left="760" Canvas.Top="1080" Style="{StaticResource NodeCard}" Width="600">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <StackPanel Spacing="8">
                            <TextBlock Text="STATUS.md" Style="{StaticResource CyberNodeTitle}" Foreground="{StaticResource NeonCyan}" />
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CyberConsole}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Canvas>
            </ScrollViewer>
        </Grid>
    </SplitView>
</Page>
