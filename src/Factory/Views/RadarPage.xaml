<Page
    x:Class="Factory.Views.RadarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Factory.Models">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- cabecalho -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="// RADAR" Style="{StaticResource CyberTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" Style="{StaticResource CyberBody}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.Sweeping, Mode=OneWay}" Foreground="{StaticResource NeonGreen}" Width="20" Height="20" />
                <Button Content="VARRER REDE" Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.SweepLanCommand}"
                        IsEnabled="{x:Bind ViewModel.Sweeping, Mode=OneWay, Converter={StaticResource Not}}"
                        ToolTipService.ToolTip="ping em toda a /24 uma vez: forca aparecer quem esta quieto na minha rede" />
                <Button Content="{x:Bind ViewModel.BeepLabel, Mode=OneWay}" Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.ToggleBeepCommand}"
                        ToolTipService.ToolTip="bipe quando surgir NOVO a menos de 10 m ou alguem entrar na minha rede" />
                <Button Content="OK, CONHEÇO" Style="{StaticResource ArcadeButton}" Command="{x:Bind ViewModel.AcknowledgeAllCommand}"
                        ToolTipService.ToolTip="tudo que esta NOVO vira conhecido (nao alerta mais)" />
                <Button Content="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" Style="{StaticResource ArcadeButtonGo}" Command="{x:Bind ViewModel.ToggleScanCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Sources, Mode=OneWay}" Style="{StaticResource CyberCaption}" />

        <!-- mostrador + lista -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CyberCard}" Padding="12" VerticalAlignment="Top">
                <!-- desenhado no code-behind: aneis, varredura e um ponto por alvo (posicao = distancia + angulo estavel) -->
                <Canvas x:Name="Scope" Width="560" Height="560" />
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sorted}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:RadarTarget">
                                <Border Style="{StaticResource CyberCard}" Padding="12" Opacity="{x:Bind Present, Mode=OneWay, Converter={StaticResource LiveOpacity}}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                Background="{x:Bind Accent, Converter={StaticResource AccentBrush}}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CyberBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CyberCaption}" FontSize="10" CharacterSpacing="150"
                                                           Foreground="{StaticResource NeonMagenta}" Visibility="{x:Bind IsNew, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CyberCaption}" FontSize="10" CharacterSpacing="150"
                                                           Foreground="{StaticResource NeonAmber}" Visibility="{x:Bind IsMoving, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="meu" Style="{StaticResource CyberCaption}" FontSize="10" Foreground="{StaticResource NeonGreen}" Visibility="{x:Bind IsMine, Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CyberCaption}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind KindLabel}" /><Run Text=" · " /><Run Text="{x:Bind Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Address}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}" Style="{StaticResource CyberBody}" HorizontalAlignment="Right"
                                                       Foreground="{x:Bind Accent, Converter={StaticResource AccentBrush}}" />
                                            <TextBlock Style="{StaticResource CyberCaption}" HorizontalAlignment="Right">
                                                <Run Text="{x:Bind RssiText, Mode=OneWay}" /><Run Text="  " /><Run Text="{x:Bind AgeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <Border Grid.Row="1" Style="{StaticResource CyberCard}" Padding="12" MaxHeight="150">
                    <StackPanel Spacing="4">
                        <TextBlock Text="EVENTOS" Style="{StaticResource CyberKicker}" />
                        <ScrollViewer MaxHeight="110">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Events}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource CyberCaption}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
